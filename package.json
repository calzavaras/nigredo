{
  "name": "nigredo-astro",
  "version": "1.14.6",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "clean:public": "node scripts/clean-public.mjs",
    "build:assets": "npx esbuild src/scripts/main.js --minify --target=es2017 --outfile=static/main.min.js",
    "validate:site": "node scripts/validate-site.mjs",
    "build": "npm run clean:public && npm run build:assets && astro build && node scripts/enrich-sitemap.mjs && node scripts/update-csp.mjs && npm run validate:site && node scripts/indexnow.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "sharp": "^0.35.3"
  }
}
