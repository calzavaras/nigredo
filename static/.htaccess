# www.nigredo.ch - Apache Konfiguration
# Saubere URLs ohne .html Endung

Options -MultiViews -Indexes
RewriteEngine On

# Einheitliche Zeichensatzangabe auch auf HTTP-Header-Ebene
AddDefaultCharset UTF-8

# Kanonische Domain zuerst erzwingen, damit alle Varianten direkt auf www landen.
RewriteCond %{HTTP_HOST} !^www\.nigredo\.ch$ [NC]
RewriteRule ^ https://www.nigredo.ch%{REQUEST_URI} [L,R=301]

# HTTPS erzwingen
# Einige Hoster terminieren SSL vor Apache. In dem Fall bleibt %{HTTPS} intern "off",
# obwohl der Browser bereits per HTTPS verbunden ist. X-Forwarded-Proto verhindert Redirect-Loops.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://www.nigredo.ch%{REQUEST_URI} [L,R=301]

# Direkt aufgerufene Index-Dateien auf die kanonische Directory-URL führen.
# THE_REQUEST verhindert Redirect-Loops mit dem internen Astro-Rewrite auf index.html.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]
RewriteCond %{THE_REQUEST} \s/+(.+)/index\.html[\s?] [NC]
RewriteRule ^(.+)/index\.html$ /$1/ [L,R=301]

# Entfernte SEO-Landingpages dauerhaft auf die beste kanonische Zielseite führen
RewriteRule ^faq-webdesign/?$ /haeufige-fragen/ [L,R=301]
RewriteRule ^lokale-seo/?$ /digitale-loesungen/ [L,R=301]
RewriteRule ^website-fuer-kmu-selbststaendige/?$ /digitale-loesungen/ [L,R=301]
RewriteRule ^website-technik-cms/?$ /digitale-loesungen/ [L,R=301]

# Kanonische Directory-URLs mit Trailing Slash
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ /$1/ [L,R=301]

# Astro Directory-Build: /pfad -> /pfad/index.html
# Dadurch bleiben saubere URLs ohne Slash möglich, obwohl der Build Verzeichnisse erzeugt.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+)$ /$1/index.html [L]

# 404 Fehlerseite
ErrorDocument 404 /404.html

# Sicherheitsheader
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), display-capture=(), interest-cohort=(), idle-detection=(), serial=(), ambient-light-sensor=(), battery=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; script-src 'self' https://cloud.umami.is 'sha256-QtgB9+QDto6Co7goV/5FEM69cNHKaM6+X0ik3cJQOrk=' 'sha256-RRyoQQGTRmJszxF2RwhnM1IE58UZroDViOjpqoZos4Y=' 'sha256-v+cBMXZuGFZFoNsqBygyrU5RC1Ay8WPDt5lD5DjMtYQ=' 'sha256-Jp5dy9almmLEf3EGcRlIci6R+DFLY6TIPPtxldb3+eQ=' 'sha256-GSXRFPg/9aGLy30bO8HDS3gS/yBbQpSxt50WUi1Lrr8=' 'sha256-RT7qGQCDzUn2ZREDG96HAy61HRucQ3etaYhKUDMdnG4=' 'sha256-lMdmyB7UBqrNjW01Ve36UX2/g0OaQTBH2qrRmTOTVVo=' 'sha256-AJzlwzOMHB/6PJO7GA2fcJGdKfRJ5111MNw7OYxYHrM=' 'sha256-JwzcoNtCqKcLAZaheRO3b8aWBjrePOZ44AIUZz3k3oA=' 'sha256-DnnYY9b0/178uKpyWHovqBOXrlbDsR0cindP9BoOUP8=' 'sha256-HhILZJypC9b/+RhfweVJH7h6TLnfmAC38mNNf4fx1r0=' 'sha256-W/DrOHpJtG3XRRTR26ogWcFhioFyDUheG7FMWyY0+fM=' 'sha256-1R5QYpxvPe6PQFAVMPStXh4SOrV2J3Te5WwDz5xI5tI=' 'sha256-lLIRfFzB3BArNG0vBpHLFmlnV+1FuOj5qRvSxKQQIZA=' 'sha256-WkEIR3nlpSlqNMOT6QH3Y/jCfs/BCluMOGh+TvRn/AY=' 'sha256-BwDIuTyvanvrn2aT29wyVRB9nMvvJftc3O99i9uT+Lo=' 'sha256-rHxdTb2dosrSC1rYM651jEGN+yBMyW27hUtxsm1phPU=' 'sha256-jyqocuMAa4VXHGS/JzUsEEhAiutJc1p37DlXl0jDwfg=' 'sha256-XHMkzIttmL/h81XpFOjs29SVupRtrNVcyVQzk2DBOhU=' 'sha256-jAub7izOPYXbshSQTTZtaTZihAbqxcDLVKVh17DwtJY=' 'sha256-r3GYi85w6Df+ToDgrURHXPDxr0CwtundrQuWOLfhtbo=' 'sha256-oWcdPwDx+f9vyMFzPIMfiagfsixME8Smpy2/B1bp0UY=' 'sha256-Oq1S3prnnWN6v05BNuB24ALqZn7VK4sQ7DPpsQrBRAM=' 'sha256-WEvQv6KIytpbqNbbmBDqtXyuFwgA0M3uA9PjIvSQAlQ=' 'sha256-LiIqWpTdFAon78jwXuSziSyk5oWI7g0ls6VZhb6El3k=' 'sha256-rA1WS22t4QsShWvCr9qLE5ocRYdSHKftseT3Mxf0l4Y=' 'sha256-9QOA9kKZ1HPQ4t7xGyFKjr05NWFcB7xthtW/uxzAlIM=' 'sha256-ZtHgCxccqX3lBHuff+ldCl+JxrIsEt4cusfdLu2ImoM=' 'sha256-2WZRA2UFc/jMEc/5dqCGI82dm9u6Wrf45WIq57wmlvI=' 'sha256-BvPPu/Ra1UaJpUIkcjB6/G7srB0z4mr1vIQD5U0BvTc='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloud.umami.is; frame-ancestors 'none'"
    <Files "send-mail.php">
        Header set X-Robots-Tag "noindex, nofollow, noarchive"
    </Files>
    Header append Vary "Accept-Encoding"
    <FilesMatch "\.(?:avif|css|gif|ico|jpe?g|js|mjs|png|svg|webp|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(?:html|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Content-Language "de-CH"
    </FilesMatch>
</IfModule>

# Brotli/GZIP Kompression
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml text/plain application/xml text/xml
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml text/xml
</IfModule>

# Browser Caching für statische Assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
