# www.nigredo.ch - Apache Konfiguration
# Saubere URLs ohne .html Endung

Options -MultiViews -Indexes
RewriteEngine On

# Einheitliche Zeichensatzangabe auch auf HTTP-Header-Ebene
AddDefaultCharset UTF-8

# Kanonische Domain zuerst erzwingen, damit alle Varianten direkt auf www landen.
RewriteCond %{HTTP_HOST} !^www\.nigredo\.ch$ [NC]
RewriteRule ^ https://www.nigredo.ch%{REQUEST_URI} [L,R=301]

# HTTPS erzwingen
# Einige Hoster terminieren SSL vor Apache. In dem Fall bleibt %{HTTPS} intern "off",
# obwohl der Browser bereits per HTTPS verbunden ist. X-Forwarded-Proto verhindert Redirect-Loops.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://www.nigredo.ch%{REQUEST_URI} [L,R=301]

# Direkt aufgerufene Index-Dateien auf die kanonische Directory-URL führen.
# THE_REQUEST verhindert Redirect-Loops mit dem internen Astro-Rewrite auf index.html.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]
RewriteCond %{THE_REQUEST} \s/+(.+)/index\.html[\s?] [NC]
RewriteRule ^(.+)/index\.html$ /$1/ [L,R=301]

# Entfernte SEO-Landingpages dauerhaft auf die beste kanonische Zielseite führen
RewriteRule ^faq-webdesign/?$ /haeufige-fragen/ [L,R=301]
RewriteRule ^lokale-seo/?$ /digitale-loesungen/ [L,R=301]
RewriteRule ^website-fuer-kmu-selbststaendige/?$ /digitale-loesungen/ [L,R=301]
RewriteRule ^website-technik-cms/?$ /digitale-loesungen/ [L,R=301]

# Kanonische Directory-URLs mit Trailing Slash
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ /$1/ [L,R=301]

# Astro Directory-Build: /pfad -> /pfad/index.html
# Dadurch bleiben saubere URLs ohne Slash möglich, obwohl der Build Verzeichnisse erzeugt.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+)$ /$1/index.html [L]

# 404 Fehlerseite
ErrorDocument 404 /404.html

# Sicherheitsheader
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), display-capture=(), interest-cohort=(), idle-detection=(), serial=(), ambient-light-sensor=(), battery=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; script-src 'self' https://cloud.umami.is 'sha256-Lxy/eCZIxzSIrGwnC6UyIL1qTi2mBlilzTqBUKls4Pg=' 'sha256-/wuuHb15eo19Gj6nKatn5AV2GP9BMxj9FoIw3UFeS78=' 'sha256-CChM5dc8UoztILz/PeuJ1/PBOwjwZgBPfcRMGfohWHM=' 'sha256-Qy9NJi2SLkUoBOZP3/kd1E6qV0inM3FqO5sdm21viTM=' 'sha256-1XboK/cCh8OE9HoXHc8VFImrMFiy519aE2VNVW5p4Zs=' 'sha256-2TEBkQLHGGWuYIn8tjx1dRpWhjHqXcKSf0qS5S3GAYQ=' 'sha256-upzI3vqpKj3LOR9pTSRgJRNodJk3Sh5944y9jpz3Hxo=' 'sha256-q/EKmc8zj03VXZ+xmnWqwBDFf3ATJiHeIJM9HBIq+/0=' 'sha256-lLZFsTYVge/6pfEO7iXn6nNdb0C71Ve4eqAulplWauE=' 'sha256-OpgUUYXKLhm5/vJBOvA+X5vUk9OkOLeR5hkuvM640kU=' 'sha256-5CO8PPMY74uVUITQC3Soh+4V3uwyxPUL85bTpvrmH18=' 'sha256-IguvcYiyY55nXA4Rz5NuOU6dMSbtldySez2fFFbNrXs=' 'sha256-XeU8Ou+h5sCzDHGXKrzl/eSEeAxFz/y+Ze9g3rPHb6U=' 'sha256-9a+Bj6LYsU7Bm1iovl/EWpi79uSbhe+TkMmBOVeVRJ8=' 'sha256-/diecHt3CeedXeGwx3UlLqtwfLRt4w/jBKGdGBW3oVk=' 'sha256-sLykkvyuKwxPDA8yBHmxyyFUAuP2bMSP9LIEu3rVlOQ=' 'sha256-gtlerbYerxBbdfdLDZCpBSnempbgcMeUjgY2oGApVYM=' 'sha256-Y3ohdHIy8WekKbmTVF+dxQXH0U0rhjnb1lNKQXkGqdw=' 'sha256-iAak/ORvF1P9vyXmLM+DkGOpdMWKa3nZatuFJSE+zSA=' 'sha256-Mf8PKcT9FEI9802577BmNGUjO/U3gJJ8EQy2mIRk3t4=' 'sha256-r3GYi85w6Df+ToDgrURHXPDxr0CwtundrQuWOLfhtbo=' 'sha256-htwrtnZ7rmfkazRsppi2BjI/yeFduXa0MDhyaVHDYhc=' 'sha256-Y6obM5qDoIdbOmS5hWSA3NnUbBSxD2a17KhbUGlzJRk=' 'sha256-QROTVlZM5S/dnB1DWMyBJ9XWp00Us4v0gdhPKc53HkQ=' 'sha256-lcnUaa1u2tFeW+W7rMbe1CfAsMRRZ7lI6nU5RzRgpkU=' 'sha256-MCc3UCwVmv9nEiTOYck30wN8sCKkE7rqXJnpVUEaNhU=' 'sha256-JPjm12KJSYfIsxWdaG2huw9cDAHm3Vhz710TtCajDzc=' 'sha256-byhRC9TPotewWehAriqcZv/9fLHKzimKrczuZuAai68=' 'sha256-YlXae+jUBBgztq7cvgQ0Pkmo4G20A+stUlJpk83og0E=' 'sha256-noHVX9A+swv2uebYQaLtUGZAhTkabZ0LPP9ZgrXT+jE='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloud.umami.is; frame-ancestors 'none'"
    <Files "send-mail.php">
        Header set X-Robots-Tag "noindex, nofollow, noarchive"
    </Files>
    Header append Vary "Accept-Encoding"
    <FilesMatch "\.(?:avif|css|gif|ico|jpe?g|js|mjs|png|svg|webp|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(?:html|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Content-Language "de-CH"
    </FilesMatch>
</IfModule>

# Brotli/GZIP Kompression
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml text/plain application/xml text/xml
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml text/xml
</IfModule>

# Browser Caching für statische Assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
