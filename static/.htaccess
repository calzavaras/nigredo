# www.nigredo.ch - Apache Konfiguration
# Saubere URLs ohne .html Endung

Options -MultiViews -Indexes
RewriteEngine On

# Einheitliche Zeichensatzangabe auch auf HTTP-Header-Ebene
AddDefaultCharset UTF-8

# Kanonische Domain zuerst erzwingen, damit alle Varianten direkt auf www landen.
RewriteCond %{HTTP_HOST} !^www\.nigredo\.ch$ [NC]
RewriteRule ^ https://www.nigredo.ch%{REQUEST_URI} [L,R=301]

# HTTPS erzwingen
# Einige Hoster terminieren SSL vor Apache. In dem Fall bleibt %{HTTPS} intern "off",
# obwohl der Browser bereits per HTTPS verbunden ist. X-Forwarded-Proto verhindert Redirect-Loops.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://www.nigredo.ch%{REQUEST_URI} [L,R=301]

# Direkt aufgerufene Index-Dateien auf die kanonische Directory-URL führen.
# THE_REQUEST verhindert Redirect-Loops mit dem internen Astro-Rewrite auf index.html.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]
RewriteCond %{THE_REQUEST} \s/+(.+)/index\.html[\s?] [NC]
RewriteRule ^(.+)/index\.html$ /$1/ [L,R=301]

# Entfernte SEO-Landingpages dauerhaft auf die beste kanonische Zielseite führen
RewriteRule ^faq-webdesign/?$ /haeufige-fragen/ [L,R=301]
RewriteRule ^lokale-seo/?$ /digitale-loesungen/ [L,R=301]
RewriteRule ^website-fuer-kmu-selbststaendige/?$ /digitale-loesungen/ [L,R=301]
RewriteRule ^website-technik-cms/?$ /digitale-loesungen/ [L,R=301]

# Kanonische Directory-URLs mit Trailing Slash
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ /$1/ [L,R=301]

# Astro Directory-Build: /pfad -> /pfad/index.html
# Dadurch bleiben saubere URLs ohne Slash möglich, obwohl der Build Verzeichnisse erzeugt.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+)$ /$1/index.html [L]

# 404 Fehlerseite
ErrorDocument 404 /404.html

# Sicherheitsheader
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), display-capture=(), interest-cohort=(), idle-detection=(), serial=(), ambient-light-sensor=(), battery=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; script-src 'self' https://cloud.umami.is 'sha256-UMcjKGH8NsKazZH5B3FzwnZU3v2+4cqF9shjpXr6Gxc=' 'sha256-2RKtJh2ZQzxpl1r3lXPQiXCM8k8DUhKQ678sxVjjT1k=' 'sha256-PGe56tm8uYr/xriHiswld+GFoW2bN4+0vDC3jM/LH+Y=' 'sha256-/vg7p+KHE+DXDu4JkJWUnoLAs53EGJLwz14oXfXaiDI=' 'sha256-wcqelOzcbjJrvHEpHC9wkfZezUgraGbmpz4CXdYWx00=' 'sha256-KnUZICE38gwdyEOHWsOuFMazdoLMT7I44dCL3G98q+8=' 'sha256-kAz0VsFuGxEeGtfmYs85p0VcJ+0zPeE5lW4KbDdYsOA=' 'sha256-ErsWcYnoMaPovvP0ga0cTND3H+yZZAq7LSL87qD+EkA=' 'sha256-/bxcPndMZ/+PrRG5HquD1WASaBKAMIwCI9QLKkLL4hI=' 'sha256-PSRfpyvJcCLi9opFwde1tGYmbv1YQhKQAtLobLhRfIg=' 'sha256-JrwWhv5MaB45VWwIe2tIsJ7e+3JFdd4rFz5cPWkb+/I=' 'sha256-Imog7bFDRu9vH81yw1ddvhBe6i1okSzCIJNJk2nWmoI=' 'sha256-9irCAxfbbp3dKJTzI+cMzpZKntarbvGJfJ3jYqvc2Xs=' 'sha256-YO9veMND+Y0Jp4Y2xG9tmtGEdpCSFjHNg1pGrzZMqMk=' 'sha256-9FaXVlZVK+mc1KJfcHbm6wLIYeTfFxvTMtdwR4eU3q4=' 'sha256-/4HDhgBqdIklVJM+b3XrTsr5heStEeBtCbtH9y2kcck=' 'sha256-QUrMqAREyGy8RrckhQsFnvWl2Qh+Eih4paCiM0sZJng=' 'sha256-mYvtKlQm96dxnyO+PxmOWtfe1+G2Cd75uqgc+1xr1VQ=' 'sha256-h4QlMZ4X8wFmgKcMXPSxN8n04VCcauDvQJYVlMsujGc=' 'sha256-eJPjv3NMAzhH9qhmgiiFwWz5Lp7/xMgDAAzmxLJ1MXE=' 'sha256-wXkPUIwmXg2Vodrv4DfgqfIHRHA4MPzWtXfUny3s/YY=' 'sha256-jMJ1MpBYc67YPlfBFUUcfJWTkdC0C30zKghMPmuGDrM=' 'sha256-tseT5WghZChW3DgGryrBd4AvM/aQUd53tFPqqLE7pDE=' 'sha256-PwYSZKs1y1MtMm7mg0sUvv6VBULkUJi3pM6zkCHWMB4=' 'sha256-LbEyENwUEfhZWVn6A4eh15Kq85TyapQepVyqPFkCcng=' 'sha256-gHOrBdlPd2zXcnVm5ZPs+466l3zPlqeVcL7yBBHXB+Q=' 'sha256-xmhFbglbgQ//YHigSsRgwQs3mulF8M0IGR0iooXeAEU=' 'sha256-U6AHdhpvnjqz8DLgf96GdCyqfKKFafPJ4qJC/E4bK+g=' 'sha256-o2+F/0AmjG+xvzLbiAtYW2mKIyUt7mbUGeC2+/ixrSI=' 'sha256-aSUaYjtVYexDQNeFpfJBjvIUyOoXz+DNftl9p2Kg9do='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloud.umami.is; frame-ancestors 'none'"
    <Files "send-mail.php">
        Header set X-Robots-Tag "noindex, nofollow, noarchive"
    </Files>
    Header append Vary "Accept-Encoding"
    <FilesMatch "\.(?:avif|css|gif|ico|jpe?g|js|mjs|png|svg|webp|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(?:html|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Brotli/GZIP Kompression
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml text/plain application/xml text/xml
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml text/xml
</IfModule>

# Browser Caching für statische Assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
