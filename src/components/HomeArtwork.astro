---
const imageProps = {
  src: '/assets/home-digital-craft-1440.webp',
  srcset: '/assets/home-digital-craft-720.webp 720w, /assets/home-digital-craft-1440.webp 1440w',
  sizes: '(max-width: 620px) 100vw, 640px',
  width: 1440,
  height: 960,
  decoding: 'async' as const,
};
---
<div class="home-artwork" aria-hidden="true">
  <div class="home-artwork__depth">
    <div class="home-artwork__surface">
      <img class="home-artwork__form" {...imageProps} alt="" fetchpriority="high" />
      <img class="home-artwork__finished" {...imageProps} alt="" />
      <span class="home-artwork__scan"></span>
    </div>
  </div>
</div>

<style>
.home-artwork { position: absolute; width: 660px; height: 440px; right: -150px; top: 214px; pointer-events: none; }
.home-artwork__depth { position: absolute; inset: 0; transform: translate3d(var(--pointer-x, 0px), calc(var(--art-offset, 0px) + var(--pointer-y, 0px)), 0); transition: transform .65s cubic-bezier(.22,1,.36,1); }
.home-artwork__surface { position: absolute; inset: 0; mask-image: radial-gradient(ellipse at center, #000 47%, transparent 74%); }
.home-artwork__form, .home-artwork__finished { position: absolute; width: 100%; height: 100%; object-fit: contain; }
.home-artwork__form { filter: grayscale(.8) brightness(.68); }
.home-artwork__finished { clip-path: inset(0 0 0 0); }
.home-artwork__scan { position: absolute; top: 13%; bottom: 8%; width: 1px; left: 0; opacity: 0; background: linear-gradient(to bottom, transparent, rgba(207,151,255,.72) 28%, rgba(122,150,255,.8) 70%, transparent); box-shadow: 0 0 18px 5px rgba(155,100,255,.15); }
@media (prefers-reduced-motion: no-preference) {
  .home-artwork__surface { animation: artwork-arrive 1.1s cubic-bezier(.22,1,.36,1) both; }
  .home-artwork__finished { animation: artwork-build 2.2s cubic-bezier(.76,0,.24,1) .45s both; }
  .home-artwork__scan { animation: artwork-scan 2.2s cubic-bezier(.76,0,.24,1) .45s both; }
  @keyframes artwork-arrive { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes artwork-build { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes artwork-scan { 0% { left: 6%; opacity: 0; } 12%, 80% { opacity: 1; } 100% { left: 94%; opacity: 0; } }
}
@media (max-width: 1100px) and (min-width: 861px) { .home-artwork { right: -115px; width: 530px; top: 225px; height: 354px; } }
@media (max-width: 860px) {
  .home-artwork { position: relative; top: auto; right: auto; width: min(620px, 100%); height: 330px; margin: 8px auto 0; }
  .home-artwork__form, .home-artwork__finished { object-fit: contain; }
}
@media (max-width: 620px) {
  .home-artwork { width: calc(100% + 40px); height: 225px; margin: 4px -20px -4px; }
  .home-artwork__form, .home-artwork__finished { object-fit: contain; }
}
@media (prefers-reduced-motion: reduce) { .home-artwork__depth { transform: none; transition: none; } .home-artwork__form, .home-artwork__scan { display: none; } }
</style>
<script>
const artwork = document.querySelector<HTMLElement>('.home-artwork');
const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
const desktop = window.matchMedia('(min-width: 861px)');
const hero = artwork?.closest('.home-hero');
let frame = 0;
function updateArtwork() {
  frame = 0;
  if (!artwork) return;
  const offset = motion.matches || !desktop.matches ? 0 : Math.min(window.scrollY, 850) * .035;
  artwork.style.setProperty('--art-offset', `${offset}px`);
}
function scheduleArtwork() { if (!frame) frame = requestAnimationFrame(updateArtwork); }
window.addEventListener('scroll', scheduleArtwork, { passive: true });
motion.addEventListener('change', scheduleArtwork);
desktop.addEventListener('change', scheduleArtwork);
hero?.addEventListener('pointermove', (event) => {
  if (motion.matches || !desktop.matches || event.pointerType === 'touch') return;
  const bounds = hero.getBoundingClientRect();
  artwork?.style.setProperty('--pointer-x', `${((event.clientX - bounds.left) / bounds.width - .5) * 12}px`);
  artwork?.style.setProperty('--pointer-y', `${((event.clientY - bounds.top) / bounds.height - .5) * 8}px`);
}, { passive: true });
hero?.addEventListener('pointerleave', () => {
  artwork?.style.setProperty('--pointer-x', '0px');
  artwork?.style.setProperty('--pointer-y', '0px');
});
updateArtwork();
</script>
