---
import ReferenzVisual from './ReferenzVisual.astro';
import { references } from '../data/references';

const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
// Die nächsten drei Referenzen der Liste (rundum), damit jede Detailseite intern verlinkt wird.
const currentIndex = references.findIndex(reference => reference.href === currentPath);
const others = [1, 2, 3].map(offset => references[(currentIndex + offset + references.length) % references.length]);
const moreImageSizes = '(max-width: 700px) calc(100vw - 48px), (max-width: 1024px) 45vw, 340px';
---

<div class="work-grid work-grid--three case-more-grid">
  {others.map(reference => (
    <article class="work-card" style={`--card-accent: ${reference.accent};`}>
      <div class="work-card__visual">
        <ReferenzVisual reference={reference} sizes={moreImageSizes} />
      </div>
      <div class="work-card__body">
        <p class="work-card__meta"><span>{reference.badge.text}</span><span>{reference.year}</span></p>
        <h3 class="work-card__title">
          <a href={reference.href} class="work-card__link" aria-label={reference.ariaLabel}>{reference.moreTitle}</a>
        </h3>
        <p class="work-card__summary">{reference.moreDesc}</p>
        <p class="work-card__role"><span>Rolle</span> {reference.rolle}</p>
        <div class="work-card__footer">
          <span class="work-card__more" aria-hidden="true">Projekt ansehen <span>→</span></span>
          {reference.liveUrl ? (
            <a href={reference.liveUrl} class="work-card__live" target="_blank" rel="noopener" aria-label={`${reference.listTitle} Website in neuem Tab öffnen`}>Website ansehen <span aria-hidden="true">↗</span></a>
          ) : (
            <span class="work-card__note">{reference.liveNote}</span>
          )}
        </div>
      </div>
    </article>
  ))}
</div>
