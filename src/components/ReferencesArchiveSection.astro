---
import Breadcrumb from './Breadcrumb.astro';
import ReferenzVisual from './ReferenzVisual.astro';
import {
  getReferencePageHref,
  type ReferenceEntry,
} from '../data/references';

interface Props {
  pageNumber: number;
  pageCount: number;
  pageItems: ReferenceEntry[];
}

const { pageNumber, pageCount, pageItems } = Astro.props;
const prevHref = pageNumber > 1 ? getReferencePageHref(pageNumber - 1) : null;
const nextHref = pageNumber < pageCount ? getReferencePageHref(pageNumber + 1) : null;
const archiveImageSizes = '(max-width: 860px) calc(100vw - 48px), 540px';
const leadImageSizes = '(max-width: 860px) calc(100vw - 48px), 640px';
const compactImageSizes = '(max-width: 700px) calc(100vw - 48px), (max-width: 1024px) 45vw, 340px';
// Erste Seite: erstes Projekt breit, der Rest im ruhigsten Raster (zwei oder drei Spalten).
const leadItem = pageNumber === 1 || pageItems.length % 2 === 1 ? pageItems[0] : null;
const restItems = leadItem ? pageItems.slice(1) : pageItems;
const threeColumns = restItems.length % 2 === 1 && restItems.length % 3 === 0;
const cards = [
  ...(leadItem ? [{ reference: leadItem, lead: true }] : []),
  ...restItems.map(reference => ({ reference, lead: false })),
];
const breadcrumbItems = [
  { label: 'Start', href: '/' },
  { label: 'Referenzen', href: '/referenzen/' },
];

if (pageNumber > 1) {
  breadcrumbItems.push({ label: `Seite ${pageNumber}` });
}
---

<section class="page-hero refs-hero" aria-labelledby="referenzen-title">
  <div class="container">
    <Breadcrumb items={breadcrumbItems} />
    <h1 id="referenzen-title" class="page-hero__title fade-up">
      Nicht nur gedacht.<br>
      <span class="gradient-text">Wirklich gemacht.</span>
    </h1>
    <div class="page-hero__row fade-up delay-100">
      <p class="page-hero__lead">
        Hier gibt es keine schönen Konzepte, die friedlich in einer Schublade schlafen. Diese Arbeiten sind aus konkreten Anforderungen entstanden und werden tatsächlich genutzt. Jedes Projekt beginnt anders. Am Ende zählt, dass etwas funktioniert, das vorher gefehlt hat.
      </p>
      {pageCount > 1 && (
        <p class="page-hero__kicker">Seite {pageNumber} von {pageCount}</p>
      )}
    </div>
  </div>
</section>

<section class="home-section refs-list-section" aria-label="Projekte">
  <div class="container">
    <div id="refs-grid" class={`work-grid${threeColumns ? ' work-grid--three' : ''}`}>
      {cards.map(({ reference, lead }, index) => (
        <article
          class={`work-card${lead ? ' work-card--lead' : ''} fade-up`}
          style={`--card-accent: ${reference.accent};`}
        >
          <div class="work-card__visual">
            <ReferenzVisual reference={reference} sizes={lead ? leadImageSizes : threeColumns ? compactImageSizes : archiveImageSizes} priority={index === 0} />
          </div>
          <div class="work-card__body">
            <p class="work-card__meta"><span>{reference.badge.text}</span><span>{reference.year}</span></p>
            <h2 class="work-card__title">
              <a href={reference.href} class="work-card__link" aria-label={reference.ariaLabel}>{reference.listTitle}</a>
            </h2>
            <p class="work-card__sub">{reference.sub}</p>
            <p class="work-card__summary">{reference.moreDesc}</p>
            <p class="work-card__role"><span>Rolle</span> {reference.rolle}</p>
            <div class="work-card__footer">
              <span class="work-card__more" aria-hidden="true">Projekt ansehen <span>→</span></span>
              {reference.liveUrl ? (
                <a href={reference.liveUrl} class="work-card__live" target="_blank" rel="noopener" aria-label={`${reference.listTitle} Website in neuem Tab öffnen`}>Website öffnen <span aria-hidden="true">↗</span></a>
              ) : (
                <span class="work-card__note">{reference.liveNote}</span>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    {pageCount > 1 && (
      <nav class="refs-pagination" aria-label="Referenzen Seiten">
        {prevHref ? (
          <a href={prevHref} class="refs-page-link refs-page-link--edge">Zurück</a>
        ) : <span class="refs-page-link refs-page-link--edge is-disabled">Zurück</span>}

        <div class="refs-page-list">
          {Array.from({ length: pageCount }, (_, index) => {
            const targetPage = index + 1;
            const href = getReferencePageHref(targetPage);
            const isCurrent = targetPage === pageNumber;

            return isCurrent ? (
              <span class="refs-page-link is-current" aria-current="page">{targetPage}</span>
            ) : (
              <a href={href} class="refs-page-link">{targetPage}</a>
            );
          })}
        </div>

        {nextHref ? (
          <a href={nextHref} class="refs-page-link refs-page-link--edge">Weiter</a>
        ) : <span class="refs-page-link refs-page-link--edge is-disabled">Weiter</span>}
      </nav>
    )}
  </div>
</section>

<section class="refs-final-section" aria-labelledby="refs-cta-title">
  <div class="container">
    <div class="section-cta refs-final-cta fade-up">
      <span class="cta-label">Dein Projekt</span>
      <h2 id="refs-cta-title">Dein Projekt fehlt noch.<br><span>Vielleicht beginnt es heute.</span></h2>
      <p>Erzähl mir kurz, worum es geht. Ich schaue mit dir auf Ausgangslage, Ziele und die passende Umsetzung.</p>
      <div class="hero-cta-group">
        <a href="/kontakt/" class="btn btn-primary">Kontakt aufnehmen</a>
        <a href="/marco-calzavara/" class="section-link">Über mich <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

<style is:global>
  body {
    --page-accent-a: var(--refs-neon-a);
    --page-accent-b: var(--refs-neon-b);
    --page-accent-c: var(--refs-neon-c);
    --page-accent: var(--refs-neon-c);
    --page-title-gradient: linear-gradient(
      102deg in oklab,
      var(--page-accent-a) 0%,
      var(--page-accent-c) 50%,
      var(--page-accent-b) 100%
    );
  }

  .refs-list-section {
    padding-top: clamp(64px, 8vw, 104px);
  }
</style>
