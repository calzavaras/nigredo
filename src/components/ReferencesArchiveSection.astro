---
import Breadcrumb from './Breadcrumb.astro';
import ReferenzVisual from './ReferenzVisual.astro';
import {
  getReferencePageHref,
  type ReferenceEntry,
} from '../data/references';

interface Props {
  pageNumber: number;
  pageCount: number;
  pageItems: ReferenceEntry[];
}

const { pageNumber, pageCount, pageItems } = Astro.props;
const prevHref = pageNumber > 1 ? getReferencePageHref(pageNumber - 1) : null;
const nextHref = pageNumber < pageCount ? getReferencePageHref(pageNumber + 1) : null;
const archiveImageSizes = '(max-width: 860px) calc(100vw - 40px), 560px';
const breadcrumbItems = [
  { label: 'Start', href: '/' },
  { label: 'Referenzen', href: '/referenzen/' },
];

if (pageNumber > 1) {
  breadcrumbItems.push({ label: `Seite ${pageNumber}` });
}
---

<section class="section pt-sub refs-hero" aria-labelledby="referenzen-title">
  <div class="container refs-hero__container">
    <Breadcrumb items={breadcrumbItems} />

    <div class="fade-up home-hero__inner refs-intro">

      <h1 id="referenzen-title" class="home-hero__title refs-hero__title">
        Nicht nur gedacht.<br>
        <span class="gradient-text">Wirklich gemacht.</span>
      </h1>
      <p class="hero-lead refs-hero__lead">
        Hier gibt es keine schönen Konzepte, die friedlich in einer Schublade schlafen. Die Referenzen zeigen Websites, KI-Anwendungen und digitale Werkzeuge, die aus konkreten Anforderungen entstanden sind. Jedes Projekt beginnt anders. Entscheidend ist, dass am Ende etwas funktioniert, das vorher gefehlt hat.
      </p>
      {pageCount > 1 && (
        <p class="refs-page-kicker">Seite {pageNumber} von {pageCount}</p>
      )}
    </div>

    <div
      id="refs-grid"
      class="refs-list"
    >
      {pageItems.map((reference, index) => (
        <article
          class="ref-project"
          style={`--card-accent: ${reference.accent};`}
        >
          <div class="ref-project__visual">
            <ReferenzVisual reference={reference} sizes={archiveImageSizes} priority={index === 0} />
          </div>
          <div class="ref-project__body">
            <div class="ref-project__meta">
              <span class="ref-project__type">
                <span class="ref-project__accent" aria-hidden="true"></span>
                {reference.badge.text}
              </span>
              <span>{reference.year}</span>
            </div>
            <h2 class="ref-project__title">{reference.listTitle}</h2>
            <p class="ref-project__sub">{reference.sub}</p>
            <p class="ref-project__summary">{reference.moreDesc}</p>
            <p class="ref-project__role">{reference.rolle}</p>
            <div class="ref-project__actions">
              <a href={reference.href} class="ref-project__details ref-project__details--stretched" aria-label={reference.ariaLabel}>Projekt ansehen <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
              {reference.liveUrl ? (
                <a href={reference.liveUrl} class="ref-project__live" target="_blank" rel="noopener" aria-label={`${reference.listTitle} Website in neuem Tab öffnen`}>Website öffnen <span aria-hidden="true">↗</span></a>
              ) : (
                <span class="ref-project__note">{reference.liveNote}</span>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    {pageCount > 1 && (
      <nav class="refs-pagination" aria-label="Referenzen Seiten">
        {prevHref ? (
          <a href={prevHref} class="refs-page-link refs-page-link--edge">Zurück</a>
        ) : <span class="refs-page-link refs-page-link--edge is-disabled">Zurück</span>}

        <div class="refs-page-list">
          {Array.from({ length: pageCount }, (_, index) => {
            const targetPage = index + 1;
            const href = getReferencePageHref(targetPage);
            const isCurrent = targetPage === pageNumber;

            return isCurrent ? (
              <span class="refs-page-link is-current" aria-current="page">{targetPage}</span>
            ) : (
              <a href={href} class="refs-page-link">{targetPage}</a>
            );
          })}
        </div>

        {nextHref ? (
          <a href={nextHref} class="refs-page-link refs-page-link--edge">Weiter</a>
        ) : <span class="refs-page-link refs-page-link--edge is-disabled">Weiter</span>}
      </nav>
    )}

    <div class="section refs-final-section">
      <div class="section-cta refs-final-cta fade-up">
        <span class="cta-label">Der nächste Schritt</span>
        <h2>Dein Projekt fehlt noch.<br><span>Vielleicht beginnt es heute.</span></h2>
        <p>Erzähl mir kurz, worum es geht. Ich schaue mit dir auf Ausgangslage, Ziele und die passende Umsetzung.</p>
        <div class="hero-cta-group" style="justify-content: center;">
          <a href="/kontakt/" class="btn btn-primary">Kontakt aufnehmen</a>
          <a href="/marco-calzavara/" class="btn btn-ghost">Über mich</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  body {
    --page-accent-a: var(--refs-neon-a);
    --page-accent-b: var(--refs-neon-b);
    --page-accent: var(--refs-neon-b);
  }

  .refs-hero {
    --refs-a: var(--refs-neon-a);
    --refs-b: var(--refs-neon-b);
    animation: none;
  }

  .refs-hero {
    min-height: min(620px, 68vh);
    display: flex;
    align-items: center;
    padding-top: var(--hero-offset-top-breadcrumb);
    padding-bottom: var(--hero-offset-bottom);
  }

  .refs-hero__container {
    position: relative;
    width: 100%;
  }

  .refs-hero .home-hero__inner {
    width: 100%;
  }

  .refs-hero .breadcrumb {
    margin-bottom: 28px;
  }

  .refs-hero .badge {
    margin-bottom: 0.95rem;
    color: rgba(219, 253, 249, 0.94);
    border-color: color-mix(in srgb, var(--refs-b) 34%, rgba(255, 255, 255, 0.22));
    background: transparent;
    box-shadow: none;
  }

  .refs-hero__title {
    max-width: 940px;
    font-size: var(--hero-title-size);
    line-height: var(--hero-title-line-height);
    letter-spacing: -0.015em;
    margin-bottom: clamp(24px, 3vw, 30px);
  }

  .refs-hero .gradient-text {
    background: var(--page-title-gradient);
    background-size: 100% auto;

    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    filter: none;
  }

  .refs-hero__lead {
    max-width: 620px;
    font-size: var(--lead-size);
    line-height: 1.65;
  }

  .refs-page-kicker {
    margin-top: 22px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .refs-intro {
    max-width: 940px;
    margin-bottom: clamp(60px, 7vw, 76px);
  }

  .refs-list {
    margin-bottom: clamp(36px, 5vw, 56px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .ref-project {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(280px, 0.78fr);
    gap: clamp(34px, 5vw, 64px);
    align-items: center;
    padding: clamp(38px, 5vw, 58px) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    position: relative;
    color: #fff;
  }

  .ref-project__visual {
    display: grid;
    place-items: center;
    min-width: 0;
    aspect-ratio: 4 / 3;
    padding: clamp(30px, 4vw, 52px);
    box-sizing: border-box;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, var(--card-accent) 18%, rgba(255, 255, 255, 0.1));
    background:
      radial-gradient(
        ellipse at 50% 48%,
        color-mix(in srgb, var(--card-accent) 22%, transparent) 0%,
        color-mix(in srgb, var(--card-accent) 8%, transparent) 50%,
        rgba(255, 255, 255, 0.02) 100%
      ),
      #09090b;
    transition: border-color 0.35s ease;
  }

  .ref-project__visual .referenz-visual {
    width: 100%;
    aspect-ratio: 8 / 5;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 7px;
    border-bottom: 0;
    box-shadow: 0 8px 8px rgba(0, 0, 0, 0.28);
  }

  .ref-project__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 4px 0;
  }

  .ref-project__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: clamp(22px, 2.6vw, 30px);
    color: var(--text-faint);
    font-size: 0.76rem;
    line-height: 1.2;
  }

  .ref-project__type {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--text-soft);
  }

  .ref-project__accent {
    width: 22px;
    height: 2px;
    flex-shrink: 0;
    background: var(--card-accent);
  }

  .ref-project__title {
    max-width: 14ch;
    margin: 0;
    color: #fff;
    font-size: clamp(1.7rem, 2.7vw, 2.35rem);
    line-height: 1.08;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .ref-project__sub {
    max-width: 34ch;
    margin: 18px 0 0;
    color: color-mix(in srgb, var(--card-accent) 74%, white 26%);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .ref-project__summary {
    max-width: 40ch;
    margin: 16px 0 0;
    color: var(--text-body);
    font-size: 0.97rem;
    line-height: 1.68;
  }

  .ref-project__role {
    margin: clamp(24px, 3vw, 34px) 0 0;
    color: var(--text-faint);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .ref-project__actions {
    display: flex;
    align-items: center;
    gap: 14px 24px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  .ref-project__details,
  .ref-project__live {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text-secondary);
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    transition: color 0.28s ease, gap 0.28s ease;
  }

  .ref-project__details--stretched::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .ref-project__details--stretched:focus-visible {
    outline: none;
  }

  .ref-project__details--stretched:focus-visible::after {
    outline: 2px solid var(--card-accent);
    outline-offset: -4px;
  }

  .ref-project__live {
    position: relative;
    z-index: 2;
    color: var(--text-soft);
  }

  .ref-project__live:focus-visible {
    outline: 2px solid var(--card-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .ref-project__note {
    max-width: 26ch;
    color: var(--text-faint);
    font-size: 0.76rem;
    line-height: 1.45;
  }

  @media (hover: hover) {
    .ref-project:hover .ref-project__visual {
      border-color: color-mix(in srgb, var(--card-accent) 40%, rgba(255, 255, 255, 0.14));
    }
    .ref-project:hover .referenz-visual__image {
      transform: scale(1.018);
    }

    .ref-project:hover .ref-project__details {
      gap: 11px;
      color: #fff;
    }

    .ref-project__live:hover {
      color: #fff;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ref-project__visual,
    .ref-project__details,
    .ref-project__live,
    .ref-project .referenz-visual__image {
      transition: none !important;
      transform: none !important;
    }
  }

  .refs-pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .refs-page-list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .refs-page-link {
    min-width: 44px;
    height: 44px;
    padding: 0 16px;
    box-sizing: border-box;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.03);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .refs-page-link.is-current {
    background: color-mix(in srgb, var(--refs-b) 16%, transparent);
    border-color: color-mix(in srgb, var(--refs-b) 34%, rgba(255, 255, 255, 0.18));
    color: #fff;
  }

  .refs-page-link.is-disabled {
    opacity: 0.4;
    pointer-events: none;
  }

  .refs-page-link--edge {
    min-width: 96px;
  }

  .refs-final-section {
    padding-top: var(--section-py-sm);
    padding-bottom: var(--section-py-md);
  }

  .refs-final-cta {
    max-width: 660px;
  }

  .refs-final-cta .cta-label {
    color: var(--text-faint);
  }

  .refs-final-cta h2 {
    color: #f5f5f7;
    font-size: var(--display-title);
    line-height: 1.04;
    letter-spacing: 0;
    margin-bottom: 0;
  }

  .refs-final-cta h2 span {
    color: var(--text-soft);
  }

  .refs-final-cta .hero-cta-group {
    margin-top: 34px;
  }

  .refs-final-cta .btn-ghost {
    background-image:
      linear-gradient(#050505, #050505),
      linear-gradient(rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0.15));
  }

  .refs-final-cta .btn-ghost:hover {
    animation: none;
    transform: translateY(-2px);
    background-image:
      linear-gradient(#0a0a0c, #0a0a0c),
      linear-gradient(rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0.3));
    box-shadow: 0 10px 26px rgba(255, 255, 255, 0.08);
  }

  .refs-final-cta .btn-primary:hover {
    box-shadow:
      inset 0 2px 4px rgba(255, 255, 255, 1),
      0 10px 26px rgba(255, 255, 255, 0.14);
  }

  @media (max-width: 860px) {
    .refs-hero {
      min-height: auto;
      padding-top: var(--hero-offset-top-breadcrumb-mobile);
      padding-bottom: 50px;
    }

    .refs-hero__title {
      font-size: var(--hero-title-size-tablet);
      line-height: var(--hero-title-line-height-mobile);
    }

    .ref-project {
      grid-template-columns: 1fr;
      gap: 28px;
      align-items: start;
    }

    .ref-project__body {
      padding: 0 2px 4px;
    }

    .ref-project__title {
      max-width: 20ch;
    }

    .refs-intro {
      margin-bottom: 52px;
    }

    .refs-pagination {
      flex-direction: column;
      align-items: stretch;
    }

    .refs-page-link--edge {
      min-width: 0;
      width: 100%;
    }
  }

  @media (max-width: 520px) {
    .refs-hero__lead {
      font-size: var(--lead-size-mobile);
      line-height: 1.6;
    }

    .refs-hero__title {
      font-size: var(--hero-title-size-mobile);
      line-height: var(--hero-title-line-height-mobile);
    }

    .refs-intro {
      margin-bottom: 42px;
    }

    .ref-project {
      gap: 24px;
      padding: 30px 0 34px;
    }

    .ref-project__meta {
      margin-bottom: 20px;
    }

    .ref-project__title {
      font-size: clamp(1.55rem, 8vw, 2rem);
    }

    .ref-project__sub {
      margin-top: 14px;
    }

    .ref-project__summary {
      margin-top: 14px;
    }

    .refs-final-section {
      padding-top: 40px;
      padding-bottom: 72px;
    }

    .refs-final-cta h2 {
      font-size: var(--display-title);
    }
  }
</style>
