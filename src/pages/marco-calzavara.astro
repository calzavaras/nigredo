---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const leadershipSinceYear = 2011;
const leadershipYears = new Date().getFullYear() - leadershipSinceYear;

const pageUrl = 'https://www.nigredo.ch/marco-calzavara/';
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.nigredo.ch/" },
        { "@type": "ListItem", "position": 2, "name": "Über mich", "item": pageUrl }
      ]
    },
    {
      "@type": ["AboutPage", "ProfilePage"],
      "@id": `${pageUrl}#webpage`,
      "name": "Marco Calzavara | Gründer von Nigredo",
      "url": pageUrl,
      "isPartOf": { "@id": "https://www.nigredo.ch/#website" },
      "breadcrumb": { "@id": `${pageUrl}#breadcrumb` },
      "inLanguage": "de-CH",
      "datePublished": "2025-06-01",
      "dateModified": "2026-07-31",
      "isAccessibleForFree": true,
      "publisher": { "@id": "https://www.nigredo.ch/#organization" },
      "about": { "@id": "https://www.nigredo.ch/#person" },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "@id": `${pageUrl}#primaryimage`,
        "url": "https://www.nigredo.ch/assets/marco-calzavara-home-v5-photo.jpg",
        "contentUrl": "https://www.nigredo.ch/assets/marco-calzavara-home-v5-photo.jpg",
        "thumbnailUrl": "https://www.nigredo.ch/assets/marco-calzavara-home-v5-photo-500.webp",
        "width": 1000,
        "height": 1000,
        "caption": "Marco Calzavara, Gründer von Nigredo in St. Gallen",
        "representativeOfPage": true
      },
      "mainEntity": { "@id": "https://www.nigredo.ch/#person" }
    },
    {
      "@type": "Person",
      "@id": "https://www.nigredo.ch/#person",
      "name": "Marco Calzavara",
      "givenName": "Marco",
      "familyName": "Calzavara",
      "jobTitle": "Gründer und Full Stack Developer",
      "description": "Marco Calzavara verbindet Führungserfahrung, Geschäftssinn, Gestaltung, Softwareentwicklung und KI zu digitalen Produkten mit Charakter.",
      "url": pageUrl,
      "mainEntityOfPage": { "@id": `${pageUrl}#webpage` },
      "worksFor": { "@id": "https://www.nigredo.ch/#organization" },
      "image": { "@id": `${pageUrl}#primaryimage` },
      "sameAs": [
        "https://ch.linkedin.com/in/calzavara-marco",
        "https://github.com/calza"
      ]
    }
  ]
});
---

<Layout
  title="Marco Calzavara | Gründer von Nigredo"
  description="Marco Calzavara verbindet Führungserfahrung, Geschäftssinn, Gestaltung, Softwareentwicklung und KI zu digitalen Produkten mit Charakter."
  canonical={pageUrl}
  ogTitle="Marco Calzavara | Gründer von Nigredo"
  ogDescription="Führungserfahrung, Gestaltung, Softwareentwicklung, KI und persönliche Verantwortung für digitale Produkte mit Charakter."
  ogType="profile"
  ogImage="https://www.nigredo.ch/assets/marco-calzavara-home-v5-photo.jpg"
  ogImageAlt="Marco Calzavara, Gründer von Nigredo"
  ogImageWidth="1000"
  ogImageHeight="1000"
  twitterTitle="Marco Calzavara | Gründer von Nigredo"
  twitterDescription="Persönlich geführte Entwicklung für Websites, Software und digitale Produkte mit KI."
  schema={schema}
  preloadImage="/assets/marco-calzavara-home-v5-photo-500.avif"
  preloadImageType="image/avif"
  preloadImageSrcset="/assets/marco-calzavara-home-v5-photo-500.avif 500w, /assets/marco-calzavara-home-v5-photo-750.avif 750w"
  preloadImageSizes="(max-width: 600px) 204px, 252px"
>
  <section class="section pt-sub about-hero" aria-labelledby="about-title">
    <div class="container about-hero__container">

      <Breadcrumb items={[
        { label: 'Start', href: '/' },
        { label: 'Über mich' }
      ]} />

      <!-- Hero -->
      <div class="fade-up home-hero__inner about-hero__intro">
        <h1 id="about-title" class="home-hero__title about-hero__title">
          <span class="about-hero__title-line">Ein Mensch.</span>
          <span class="gradient-text about-hero__title-line">1001 Ideen.</span>
        </h1>
      </div>

      <!-- Main Profile & Intro Grid -->
      <div class="au-main-grid mt-80">
        <div class="au-profile-column fade-up delay-100">
          <div class="au-photo-container">
            <div class="au-photo-aura"></div>
            <div class="au-photo-circle-wrap">
              <picture>
                <source srcset="/assets/marco-calzavara-home-v5-photo-500.avif 500w, /assets/marco-calzavara-home-v5-photo-750.avif 750w" sizes="(max-width: 600px) 204px, 252px" type="image/avif">
                <source srcset="/assets/marco-calzavara-home-v5-photo-500.webp 500w, /assets/marco-calzavara-home-v5-photo-750.webp 750w" sizes="(max-width: 600px) 204px, 252px" type="image/webp">
                <img
                  src="/assets/marco-calzavara-home-v5-photo.jpg"
                  alt="Marco Calzavara, Gründer und Inhaber von Nigredo in St. Gallen"
                  class="au-photo-circle"
                  width="1000"
                  height="1000"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              </picture>
            </div>
          </div>
          <div class="au-profile-info">
            <h2 class="au-name">Marco Calzavara</h2>
            <p class="au-role">Gründer und direkter Ansprechpartner</p>
          </div>
        </div>

        <div class="au-content-column fade-up delay-150">
          <div class="au-statement">
            <blockquote class="hero-lead about-statement__quote">
              Die stärkste davon erhält keine lange Präsentation, sondern möglichst bald einen ersten funktionierenden Entwurf.
            </blockquote>
          </div>
          
          <div class="au-bio">
            <p class="au-bio-intro">
              Mich interessieren Situationen, in denen etwas klarer, einfacher, schöner oder wirksamer werden könnte. Ich höre genau hin, erkenne Zusammenhänge und verbinde Einfühlungsvermögen, Geschäftssinn, Gestaltung und technische Möglichkeiten zu einer umsetzbaren Richtung. Ideen, die jahrelang auf ihren perfekten Moment warten, sind nicht meine Disziplin.
            </p>
            
            <div class="au-bio-more" data-bio-more>
              <button
                type="button"
                class="au-bio-more__toggle"
                aria-expanded="false"
                aria-controls="au-bio-more-content"
                data-bio-more-toggle
              >
                Mehr erfahren
              </button>
              <div id="au-bio-more-content" class="au-bio-more__panel" hidden data-bio-more-panel>
                <div class="au-bio-more__content">
                  <p>
                    Seit 2009 arbeite ich bei der IV-Stelle, seit 2011 in einer Führungsfunktion. Heute leite ich ein Expertenteam und verantworte die fachliche und organisatorische Weiterentwicklung einer Abteilung. Diese Arbeit hat meinen Blick geprägt: Menschen verstehen, Interessen erkennen, Informationen ordnen und Entscheidungen so treffen, dass sie im Alltag bestehen.
                  </p>
                  <p>
                    Parallel dazu habe ich Unternehmen gegründet, aufgebaut und verkauft. Gemeinsam mit einem Geschäftspartner führe ich die HappyPath GmbH, die mit TextRoom eine schweizweit eingesetzte Software für Sozialversicherungen entwickelt.
                  </p>
                  <p>
                    Mit Nigredo verbinde ich Führungserfahrung, Einfühlungsvermögen, Geschäftssinn, Gestaltung und moderne Technologie. Daraus entsteht eine Arbeitsweise, die genau zuhört, zügig entscheidet und Gedanken tatsächlich in Bewegung bringt.
                  </p>
                  <p>
                    <strong>KI erweitert meine Werkbank.</strong> Ich habe ein System aus mehreren hundert spezialisierten KI-Agenten und abgestimmten Arbeitsabläufen aufgebaut. Sie unterstützen Recherche, Strategie, Text, Gestaltung, Programmierung, Tests und Gegenprüfung. Manche entwickeln Vorschläge. Andere suchen bewusst nach Schwächen oder stellen unbequeme Fragen.
                  </p>
                  <p>
                    Ich führe die Ergebnisse zusammen, treffe die Entscheidungen und prüfe, ob das Resultat fachlich, sprachlich, gestalterisch und technisch überzeugt. KI ersetzt weder meine Kreativität noch meine Verantwortung. Sie macht gute Ideen früher sichtbar, besser prüfbar und schneller umsetzbar.
                  </p>
                  <p>
                    <strong>Ein gutes Netzwerk gehört dazu.</strong> Für besondere Anforderungen arbeite ich mit Fachleuten für Entwicklung, Datenbanken, Infrastruktur, Sicherheit, Datenschutz und komplexe Systemarchitektur zusammen.
                  </p>
                  <p>
                    Je nach Projekt stelle ich die passende Kombination zusammen. Für dich bleibt die Zusammenarbeit einfach: Ich bin dein direkter Ansprechpartner, halte die Fäden zusammen und stehe für das Ergebnis ein.
                  </p>
                  <button type="button" class="au-bio-more__toggle au-bio-more__toggle--close" data-bio-more-close>
                    Weniger anzeigen
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Stats -->
      <div class="au-stats-grid mt-80 fade-up delay-200">
        <div class="au-stat-card">
          <div class="au-stat-inner">
            <span class="au-stat-value">{leadershipYears}+</span>
            <span class="au-stat-desc">Jahre Führungserfahrung</span>
          </div>
        </div>
        <div class="au-stat-card">
          <div class="au-stat-inner">
            <span class="au-stat-value">3×</span>
            <span class="au-stat-desc">Unternehmen gegründet, aufgebaut und verkauft</span>
          </div>
        </div>
        <div class="au-stat-card">
          <div class="au-stat-inner">
            <span class="au-stat-value au-stat-value--words">Mehrere hundert</span>
            <span class="au-stat-desc">spezialisierte KI-Agenten im Werkzeugkasten</span>
          </div>
        </div>
        <div class="au-stat-card">
          <div class="au-stat-inner">
            <span class="au-stat-value">1</span>
            <span class="au-stat-desc">direkter Ansprechpartner</span>
          </div>
        </div>
      </div>

      <!-- Principles -->
      <div class="mt-80 fade-up delay-300">
        <h2>Was meine Arbeit antreibt.</h2>
        <div class="grid-3">
          <article class="card au-principle-card">
            <div class="au-principle-number">01</div>
            <h3>Ideen wollen Bewegung.</h3>
            <p class="au-principle-text">Eine Idee gewinnt nicht dadurch an Wert, dass man länger über sie spricht. Fast immer braucht es jemanden, der beginnt.</p>
          </article>
          <article class="card au-principle-card">
            <div class="au-principle-number">02</div>
            <h3>KI vergrössert die Werkbank.</h3>
            <p class="au-principle-text">Technologie eröffnet Möglichkeiten. Die Richtung entsteht trotzdem aus Verständnis, Urteil und Erfahrung.</p>
          </article>
          <article class="card au-principle-card">
            <div class="au-principle-number">03</div>
            <h3>Stillstand ist höchstens ein kurzer Ladebildschirm.</h3>
            <p class="au-principle-text">Wenn ein Ablauf einfacher oder eine Idee wirksamer werden kann, fällt es mir schwer, sie einfach liegen zu lassen.</p>
          </article>
        </div>
      </div>

      <!-- CTA -->
      <div class="section about-final-section fade-up">
        <div class="section-cta about-final-cta">
          <span class="cta-label">Direkter Austausch</span>
          <h2>Eine gute Idee braucht<br><span>noch keinen perfekten Plan.</span></h2>
          <p>Bring mir den unfertigen Gedanken, das störende Problem oder die Vorstellung, die dich nicht mehr loslässt. Wir finden heraus, was daraus werden kann.</p>
          <div class="hero-cta-group" style="justify-content: center;">
            <a href="/kontakt/" class="btn btn-primary">Direkt schreiben</a>
            <a href="/referenzen/" class="btn btn-ghost">Projekte ansehen</a>
          </div>
        </div>
      </div>

    </div>
  </section>
</Layout>

<script>
  const bioMore = document.querySelector('[data-bio-more]');
  const bioMoreToggle = bioMore?.querySelector('[data-bio-more-toggle]');
  const bioMoreClose = bioMore?.querySelector('[data-bio-more-close]');
  const bioMorePanel = bioMore?.querySelector('[data-bio-more-panel]');

  if (bioMoreToggle instanceof HTMLButtonElement && bioMorePanel instanceof HTMLElement) {
    let closeTimer: number | undefined;

    const setBioMoreOpen = (shouldOpen: boolean) => {
      window.clearTimeout(closeTimer);
      bioMoreToggle.setAttribute('aria-expanded', String(shouldOpen));

      if (shouldOpen) {
        bioMorePanel.hidden = false;
        bioMoreToggle.hidden = true;
        window.requestAnimationFrame(() => {
          bioMorePanel.classList.add('is-open');
        });
        return;
      }

      bioMorePanel.classList.remove('is-open');
      bioMoreToggle.hidden = false;
      closeTimer = window.setTimeout(() => {
        if (bioMoreToggle.getAttribute('aria-expanded') !== 'true') {
          bioMorePanel.hidden = true;
        }
      }, 480);
    };

    bioMoreToggle.addEventListener('click', () => setBioMoreOpen(true));

    if (bioMoreClose instanceof HTMLButtonElement) {
      bioMoreClose.addEventListener('click', () => setBioMoreOpen(false));
    }
  }
</script>

<style>
  :global(body) {
    --about-a: var(--about-neon-a);
    --about-b: var(--about-neon-b);
    --about-c: oklch(24.7% 0.047 44.8);
    --about-d: oklch(13.8% 0.044 20.2);
    --about-light: var(--about-neon-b);
    --page-accent-a: var(--about-neon-a);
    --page-accent-b: var(--about-neon-b);
    --page-accent-c: var(--about-neon-c);
    --page-title-gradient: linear-gradient(
      102deg in oklab,
      var(--page-accent-a) 0%,
      var(--page-accent-c) 50%,
      var(--page-accent-b) 100%
    );
    background: var(--bg-color);
  }

  :global(body)::before {
    display: none;
  }

  .about-hero {
    --page-accent: var(--about-neon-c);
    animation: none;
    padding-top: var(--hero-offset-top-breadcrumb);
    padding-bottom: var(--hero-offset-bottom);
    background: transparent;
  }

  .about-hero__container {
    position: relative;
    width: 100%;
  }

  .about-hero :global(.breadcrumb) {
    margin-bottom: 28px;
  }

  .about-hero .badge {
    margin-bottom: 0.95rem;
    color: var(--about-light);
    border-color: color-mix(in srgb, var(--about-b) 48%, rgba(255, 255, 255, 0.2));
    background: transparent;
    box-shadow: none;
  }

  .about-hero__intro {
    width: 100%;
    max-width: 940px;
  }

  .about-hero__title {
    max-width: 960px;
    font-size: clamp(3.05rem, 5.25vw, 4.8rem);
    line-height: var(--hero-title-line-height);
    letter-spacing: -0.02em;
    margin-bottom: 0;
  }

  .about-hero__title-line {
    display: block;
    white-space: nowrap;
  }

  .about-hero .gradient-text {
    background: var(--page-title-gradient);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--about-a);
    filter: none;
  }

  /* Main Layout Grid */
  .au-main-grid {
    display: grid;
    grid-template-columns: minmax(280px, 340px) minmax(0, 1fr);
    gap: clamp(44px, 6vw, 80px);
    align-items: start;
    margin-top: clamp(64px, 7vw, 82px);
  }

  .au-content-column {
    --au-copy-max-width: 690px;
  }

  /* Profile Column */
  .au-profile-column {
    position: sticky;
    top: 132px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .au-photo-container {
    position: relative;
    width: min(100%, 304px);
    aspect-ratio: 4 / 5;
    height: auto;
    margin: 0 0 28px 14px;
  }

  .au-photo-aura {
    position: absolute;
    inset: 18px 14px -18px -14px;
    background: linear-gradient(
      145deg,
      var(--about-a) 0%,
      var(--about-b) 42%,
      var(--about-c) 76%,
      var(--about-d) 100%
    );
    border-radius: var(--radius-lg);
    filter: none;
    opacity: 0.96;
  }

  .au-photo-circle-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--about-a) 24%, rgba(255, 255, 255, 0.08));
    background: var(--about-d);
    z-index: 1;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 8px 8px rgba(0, 0, 0, 0.22);
  }

  .au-photo-circle {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    cursor: default;
    transition: transform 0.6s cubic-bezier(0.2, 0, 0.2, 1);
  }

  .au-photo-circle:hover { transform: scale(1.02); }

  .au-name {
    font-size: clamp(1.28rem, 2vw, 1.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 7px;
    color: #fff;
  }

  .au-role {
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--about-a) 48%, white 30%);
    letter-spacing: 0;
    text-transform: none;
    margin: 0;
  }

  /* Content Column */
  .au-statement {
    max-width: var(--au-copy-max-width);
    margin-bottom: 32px;
  }

  .au-statement .about-statement__quote {
    max-width: var(--au-copy-max-width);
    box-sizing: border-box;
    font-size: clamp(1.12rem, 1.5vw, 1.3rem);
    line-height: 1.58;
    color: rgba(245, 245, 247, 0.96);
    font-style: normal;
    font-weight: 550;
    margin: 0;
    padding: 0 0 28px;
    border-bottom: 1px solid color-mix(in srgb, var(--about-b) 44%, rgba(255, 255, 255, 0.1));
    border-radius: 0;
    border-top: 0;
    border-left: 0;
    border-right: 0;
    background: transparent;
    box-shadow: none;
  }

  .au-bio p {
    max-width: var(--au-copy-max-width);
    font-size: var(--lead-size);
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .au-bio-intro {
    color: rgba(245, 245, 247, 0.76);
    margin-bottom: 20px;
  }

  .au-bio strong {
    color: #fff;
    font-weight: 700;
  }

  .au-bio-more {
    max-width: var(--au-copy-max-width);
    margin-top: 0;
  }

  .au-bio-more__toggle {
    appearance: none;
    display: inline-block;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--about-a);
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.25;
    cursor: pointer;
    transition:
      color 0.24s ease,
      transform 0.24s ease;
  }

  .au-bio-more__toggle[hidden] {
    display: none !important;
  }

  .au-bio-more__toggle:hover,
  .au-bio-more__toggle:focus-visible {
    color: var(--about-light);
  }

  .au-bio-more__toggle:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--about-a) 44%, transparent);
    outline-offset: 5px;
  }

  .au-bio-more__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.48s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .au-bio-more__panel.is-open {
    grid-template-rows: 1fr;
  }

  .au-bio-more__panel[hidden] {
    display: none;
  }

  .au-bio-more__content {
    overflow: hidden;
    min-height: 0;
  }

  .au-bio-more__content p {
    max-width: 760px;
    font-size: var(--lead-size);
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .au-bio-more__toggle--close {
    margin-top: 2px;
  }

  /* Stats Grid */
  .au-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0;
    border-top: 1px solid color-mix(in srgb, var(--about-b) 28%, rgba(255, 255, 255, 0.08));
    border-bottom: 1px solid color-mix(in srgb, var(--about-b) 28%, rgba(255, 255, 255, 0.08));
    margin-top: clamp(68px, 7vw, 84px);
  }

  .au-stat-card {
    padding: 0;
    border-radius: 0;
    border: 0;
    border-left: 1px solid color-mix(in srgb, var(--about-b) 22%, rgba(255, 255, 255, 0.06));
    background: transparent;
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.35s ease,
      box-shadow 0.35s ease,
      background 0.35s ease;
  }

  .au-stat-card:hover {
    transform: none;
    border-color: color-mix(in srgb, var(--about-b) 32%, rgba(255, 255, 255, 0.08));
    background: color-mix(in srgb, var(--about-d) 72%, transparent);
    box-shadow: none;
  }

  .au-stat-card:first-child { border-left: 0; }

  .au-stat-inner {
    padding: 30px 24px;
    text-align: center;
    height: 100%;
    box-sizing: border-box;
  }

  .au-stat-value {
    font-size: clamp(2.55rem, 4.2vw, 3rem);
    font-weight: 700;
    line-height: 1;
    margin-bottom: 10px;
    display: block;
    color: var(--about-a);
  }

  .au-stat-card:nth-child(2) .au-stat-value {
    color: var(--about-neon-c);
  }

  .au-stat-card:nth-child(3) .au-stat-value {
    color: var(--about-b);
  }

  .au-stat-card:nth-child(4) .au-stat-value {
    color: var(--about-neon-c);
  }

  .au-stat-value--words {
    font-size: 1.9rem;
    line-height: 1.05;
  }

  .au-stat-desc {
    font-size: 0.85rem;
    color: var(--text-faint);
    line-height: 1.45;
  }

  .mt-80.fade-up.delay-300 {
    margin-top: 84px;
  }

  /* Principles specific */
  .au-principle-card {
    padding: 28px 0 0;
    border: 0;
