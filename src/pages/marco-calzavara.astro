---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const leadershipSinceYear = 2011;
const leadershipYears = new Date().getFullYear() - leadershipSinceYear;

const pageUrl = 'https://www.nigredo.ch/marco-calzavara/';
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.nigredo.ch/" },
        { "@type": "ListItem", "position": 2, "name": "Über mich", "item": pageUrl }
      ]
    },
    {
      "@type": ["AboutPage", "ProfilePage"],
      "@id": `${pageUrl}#webpage`,
      "name": "Marco Calzavara | Unternehmer und Gründer von Nigredo",
      "headline": "Marco Calzavara, Unternehmer und Gründer von Nigredo",
      "description": "Marco Calzavara ist Unternehmer, Gründer von Nigredo und Full Stack Developer in St. Gallen. Er verbindet Führung, Gestaltung, Softwareentwicklung und KI.",
      "url": pageUrl,
      "isPartOf": { "@id": "https://www.nigredo.ch/#website" },
      "breadcrumb": { "@id": `${pageUrl}#breadcrumb` },
      "inLanguage": "de-CH",
      "datePublished": "2025-06-01",
      "dateModified": "2026-10-28T12:00:00+01:00",
      "isAccessibleForFree": true,
      "author": { "@id": "https://www.nigredo.ch/#person" },
      "publisher": { "@id": "https://www.nigredo.ch/#organization" },
      "about": { "@id": "https://www.nigredo.ch/#person" },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "@id": `${pageUrl}#primaryimage`,
        "url": "https://www.nigredo.ch/assets/marco-calzavara-home-v5-photo.jpg",
        "contentUrl": "https://www.nigredo.ch/assets/marco-calzavara-home-v5-photo.jpg",
        "thumbnailUrl": "https://www.nigredo.ch/assets/marco-calzavara-home-v5-photo-500.webp",
        "width": 1000,
        "height": 1000,
        "caption": "Marco Calzavara, Gründer von Nigredo in St. Gallen",
        "representativeOfPage": true
      },
      "mainEntity": { "@id": "https://www.nigredo.ch/#person" }
    },
    {
      "@type": "Person",
      "@id": "https://www.nigredo.ch/#person",
      "name": "Marco Calzavara",
      "givenName": "Marco",
      "familyName": "Calzavara",
      "jobTitle": "Unternehmer, Gründer und Full Stack Developer",
      "description": "Marco Calzavara ist Unternehmer, Gründer von Nigredo und Full Stack Developer in St. Gallen. Er verbindet Führung, Gestaltung, Softwareentwicklung und KI.",
      "url": pageUrl,
      "mainEntityOfPage": { "@id": `${pageUrl}#webpage` },
      "worksFor": { "@id": "https://www.nigredo.ch/#organization" },
      "affiliation": { "@id": "https://happypath.ch/#organization" },
      "knowsAbout": ["Führung", "Unternehmertum", "Webdesign", "Softwareentwicklung", "Künstliche Intelligenz", "Branding", "User Experience Design", "Automatisierung"],
      "image": { "@id": `${pageUrl}#primaryimage` },
      "sameAs": [
        "https://ch.linkedin.com/in/calzavara-marco",
        "https://github.com/calza"
      ]
    },
    {
      "@type": "Organization",
      "@id": "https://happypath.ch/#organization",
      "name": "HappyPath GmbH",
      "url": "https://happypath.ch/",
      "description": "HappyPath entwickelt TextRoom, eine Software, die bei der Mehrheit der IV-Stellen in der Schweiz eingesetzt wird."
    }
  ]
});
---

<Layout
  title="Marco Calzavara | Unternehmer und Gründer von Nigredo"
  description="Marco Calzavara ist Unternehmer, Gründer von Nigredo und Full Stack Developer in St. Gallen. Er verbindet Führung, Gestaltung, Softwareentwicklung und KI."
  canonical={pageUrl}
  ogTitle="Marco Calzavara | Unternehmer und Gründer von Nigredo"
  ogDescription="Führung, Unternehmertum, Gestaltung, Softwareentwicklung und KI: Marco Calzavara entwickelt digitale Produkte persönlich und mit klarer Verantwortung."
  ogType="profile"
  ogImage="https://www.nigredo.ch/assets/marco-calzavara-home-v5-photo.jpg"
  ogImageAlt="Marco Calzavara, Gründer von Nigredo"
  ogImageWidth="1000"
  ogImageHeight="1000"
  twitterTitle="Marco Calzavara | Unternehmer und Gründer von Nigredo"
  twitterDescription="Unternehmer, Full Stack Developer und Gründer von Nigredo in St. Gallen. Führung, Gestaltung, Softwareentwicklung und KI aus einer Hand."
  author="Marco Calzavara"
  profileFirstName="Marco"
  profileLastName="Calzavara"
  profileUsername="calzavara-marco"
  schema={schema}
  preloadImage="/assets/marco-calzavara-home-v5-photo-500.avif"
  preloadImageType="image/avif"
  preloadImageSrcset="/assets/marco-calzavara-home-v5-photo-500.avif 500w, /assets/marco-calzavara-home-v5-photo-750.avif 750w"
  preloadImageSizes="(max-width: 860px) 80vw, 460px"
>
  <section class="page-hero about-hero" aria-labelledby="about-title">
    <div class="container">
      <Breadcrumb items={[
        { label: 'Start', href: '/' },
        { label: 'Über mich' }
      ]} />
      <h1 id="about-title" class="page-hero__title fade-up">
        Ein Mensch.<br>
        <span class="gradient-text">1001 Ideen.</span>
      </h1>
    </div>
  </section>

  <section class="home-section about-profile" aria-label="Profil">
    <div class="container about-split about-profile__grid">
      <figure class="about-split__portrait about-profile__portrait fade-up">
        <picture>
          <source srcset="/assets/marco-calzavara-home-v5-photo-500.avif 500w, /assets/marco-calzavara-home-v5-photo-750.avif 750w" sizes="(max-width: 860px) 80vw, 460px" type="image/avif">
          <source srcset="/assets/marco-calzavara-home-v5-photo-500.webp 500w, /assets/marco-calzavara-home-v5-photo-750.webp 750w" sizes="(max-width: 860px) 80vw, 460px" type="image/webp">
          <img
            src="/assets/marco-calzavara-home-v5-photo.jpg"
            alt="Marco Calzavara, Gründer und Inhaber von Nigredo in St. Gallen"
            width="1000"
            height="1000"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
        <figcaption>
          <h2 class="about-profile__name">Marco Calzavara</h2>
          <p class="about-profile__role">Gründer und direkter Ansprechpartner</p>
        </figcaption>
      </figure>

      <div class="about-profile__content fade-up delay-100">
        <blockquote class="about-profile__quote">
          Die stärksten Ideen sind selten sofort offensichtlich. Mich interessiert der Moment, in dem sie sichtbar werden.
        </blockquote>
        <div class="au-bio">
          <p class="au-bio-intro">
            Mich ziehen Aufgaben an, die noch keine klare Form haben. Wo andere einzelne Teile sehen, erkenne ich oft bereits einen Zusammenhang. Ich höre genau hin, ordne, verbinde und folge einer Spur, bis aus einer Ahnung etwas entsteht, das trägt.
          </p>
          <p>
            <em>Nigredo ist in der Alchemie die dunkle Phase der Wandlung. Altes verliert seine Form, Verborgenes tritt hervor. So entsteht Raum für etwas Neues, Schönes und Kraftvolles.</em>
          </p>
        <div class="au-bio-more" data-bio-more>
          <button
            type="button"
            class="au-bio-more__toggle"
            aria-expanded="false"
            aria-controls="au-bio-more-content"
            data-bio-more-toggle
          >
            Mehr erfahren
          </button>
          <div id="au-bio-more-content" class="au-bio-more__panel" hidden="until-found" data-bio-more-panel>
            <div class="au-bio-more__content">
              <p>
                Mein Weg führt durch Welten, die auf den ersten Blick wenig miteinander zu tun haben und gerade deshalb erstaunlich gut zusammenpassen.
              </p>
              <p>
                Seit 2009 arbeite ich bei der IV-Stelle, seit 2011 in einer Führungsfunktion. Heute leite ich ein Expertenteam und entwickle eine Abteilung fachlich und organisatorisch weiter. Diese Arbeit hat meinen Blick geschärft: für Menschen, Systeme und jene feinen Zusammenhänge, an denen gute Entscheidungen hängen.
              </p>
              <p>
                Parallel dazu habe ich mehrere Unternehmen gegründet und aufgebaut, einige davon später verkauft. Derzeit führe ich gemeinsam mit einem Geschäftspartner die HappyPath GmbH. Mit TextRoom entwickeln wir eine Software, die bei der Mehrheit der IV-Stellen in der Schweiz eingesetzt wird. Ideen kenne ich deshalb in verschiedenen Aggregatszuständen: als Skizze, als Herausforderung und als funktionierendes Produkt.
              </p>
              <p>
                Mit Nigredo verbinde ich Führung, Einfühlungsvermögen, Geschäftssinn, Gestaltung, Softwareentwicklung und KI. Mich fasziniert der Augenblick, in dem sich Komplexität plötzlich ordnet und eine Lösung erscheint, die im Nachhinein beinahe selbstverständlich wirkt.
              </p>
              <p>
                Dafür habe ich ein System aus mehreren hundert spezialisierten KI-Agenten aufgebaut. Einige entwickeln Möglichkeiten, andere suchen Schwächen. Die wertvollsten widersprechen mir.
              </p>
              <p>
                Richtung, Urteil und Verantwortung bleiben bei mir. Wenn zusätzliche Tiefe gefragt ist, ergänze ich das Projekt mit ausgewählten Fachleuten aus meinem Netzwerk. Für dich bleibt es einfach: ein direkter Ansprechpartner, kurze Wege und ein Ergebnis, hinter dem ich persönlich stehe.
              </p>
              <button type="button" class="au-bio-more__toggle au-bio-more__toggle--close" data-bio-more-close>
                Weniger anzeigen
              </button>
            </div>
          </div>
        </div>
        </div>
      </div>
    </div>
  </section>

  <section class="home-section about-stats" aria-label="Kennzahlen">
    <div class="container">
      <ul class="stat-row fade-up">
        <li><strong>{leadershipYears}+</strong><span>Jahre Führungserfahrung</span></li>
        <li><strong>3×</strong><span>Unternehmen gegründet, aufgebaut und verkauft</span></li>
        <li><strong class="stat-row__words">Mehrere hundert</strong><span>spezialisierte KI-Agenten im Werkzeugkasten</span></li>
        <li><strong>1</strong><span>direkter Ansprechpartner</span></li>
      </ul>
    </div>
  </section>

  <section class="home-section about-principles" aria-labelledby="about-principles-title">
    <div class="container">
      <div class="home-head fade-up">
        <h2 id="about-principles-title" class="home-head__title">Was meine Arbeit antreibt.</h2>
      </div>
      <div class="open-cards">
        <article class="open-card fade-up">
          <h3>Sehen, was noch verborgen ist.</h3>
          <p>Die entscheidende Idee liegt oft zwischen den offensichtlichen.</p>
        </article>
        <article class="open-card fade-up delay-100">
          <h3>Verbinden, was andere getrennt betrachten.</h3>
          <p>Mensch, Geschäft, Gestaltung und Technik ergeben gemeinsam ein anderes Bild.</p>
        </article>
        <article class="open-card fade-up delay-200">
          <h3>Aus Gedanken Wirklichkeit machen.</h3>
          <p>Eine Idee zeigt ihre Stärke erst, wenn sie eine Form bekommt.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="about-final-section" aria-labelledby="about-cta-title">
    <div class="container">
      <div class="section-cta about-final-cta fade-up">
        <span class="cta-label">Direkter Austausch</span>
        <h2 id="about-cta-title">Vielleicht ist die Form schon da.<br><span>Sie muss nur noch gefunden werden.</span></h2>
        <p>Erzähl mir von dem Gedanken, der dich nicht loslässt, oder von dem Problem, das längst eine bessere Lösung verdient. Wir finden heraus, was darin steckt.</p>
        <div class="hero-cta-group">
          <a href="/kontakt/" class="btn btn-primary">Direkt schreiben</a>
          <a href="/referenzen/" class="section-link">Projekte ansehen <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const bioMore = document.querySelector('[data-bio-more]');
  const bioMoreToggle = bioMore?.querySelector('[data-bio-more-toggle]');
  const bioMoreClose = bioMore?.querySelector('[data-bio-more-close]');
  const bioMorePanel = bioMore?.querySelector('[data-bio-more-panel]');

  if (bioMoreToggle instanceof HTMLButtonElement && bioMorePanel instanceof HTMLElement) {
    let closeTimer: number | undefined;

    const setBioMoreOpen = (shouldOpen: boolean) => {
      window.clearTimeout(closeTimer);
      bioMoreToggle.setAttribute('aria-expanded', String(shouldOpen));

      if (shouldOpen) {
        bioMorePanel.hidden = false;
        bioMoreToggle.hidden = true;
        window.requestAnimationFrame(() => {
          bioMorePanel.classList.add('is-open');
        });
        return;
      }

      bioMorePanel.classList.remove('is-open');
      bioMoreToggle.hidden = false;
      closeTimer = window.setTimeout(() => {
        if (bioMoreToggle.getAttribute('aria-expanded') !== 'true') {
          // Eingeklappt, aber für Seitensuche und Suchmaschinen auffindbar.
          bioMorePanel.setAttribute('hidden', 'until-found');
        }
      }, 480);
    };

    bioMoreToggle.addEventListener('click', () => setBioMoreOpen(true));
    bioMorePanel.addEventListener('beforematch', () => setBioMoreOpen(true));

    if (bioMoreClose instanceof HTMLButtonElement) {
      bioMoreClose.addEventListener('click', () => setBioMoreOpen(false));
    }
  }
</script>

<style>
  :global(body) {
    --about-a: var(--about-neon-a);
    --about-b: var(--about-neon-b);
    --about-c: oklch(24.7% 0.047 44.8);
    --about-d: oklch(13.8% 0.044 20.2);
    --about-light: var(--about-neon-c);
    --about-stat-long: oklch(67% 0.14 344);
    --page-accent-a: var(--about-neon-a);
    --page-accent-b: var(--about-neon-b);
    --page-accent-c: var(--about-neon-c);
    --page-title-gradient: linear-gradient(
      102deg in oklab,
      var(--page-accent-a) 0%,
      var(--page-accent-c) 50%,
      var(--page-accent-b) 100%
    );
    background: var(--bg-color);
  }

  :global(body)::before {
    display: none;
  }

  .au-bio-more {
    max-width: 620px;
    margin-top: 0;
  }

  .au-bio-more__toggle {
    appearance: none;
    display: inline-block;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--about-a);
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.25;
    cursor: pointer;
    transition:
      color 0.24s ease,
      transform 0.24s ease;
  }

  .au-bio-more__toggle[hidden] {
    display: none !important;
  }

  .au-bio-more__toggle:hover,
  .au-bio-more__toggle:focus-visible {
    color: var(--about-light);
  }

  .au-bio-more__toggle:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--about-a) 44%, transparent);
    outline-offset: 5px;
  }

  .au-bio-more__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.48s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .au-bio-more__panel.is-open {
    grid-template-rows: 1fr;
  }

  .au-bio-more__panel[hidden]:not([hidden="until-found"]) {
    display: none;
  }

  .au-bio-more__content {
    overflow: hidden;
    min-height: 0;
  }

  .au-bio-more__content p {
    max-width: 760px;
    font-size: var(--lead-size);
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .au-bio-more__toggle--close {
    margin-top: 2px;
  }

  .about-profile {
    padding-top: clamp(64px, 8vw, 104px);
  }

  .about-profile__grid {
    align-items: start;
  }

  .about-profile__portrait figcaption {
    left: 28px;
    bottom: 24px;
    right: 28px;
  }

  .about-profile__name {
    margin: 0;
    color: #f5f5f7;
    font-size: 1.5rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .about-profile__role {
    margin: 6px 0 0;
    color: var(--text-soft);
    font-size: 0.9rem;
  }

  .about-profile__quote {
    margin: 0 0 clamp(28px, 3vw, 40px);
    padding: 0;
    border: 0;
    color: #f5f5f7;
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .au-bio p {
    max-width: 620px;
    margin: 0 0 20px;
    color: var(--text-body);
    font-size: 1.04rem;
    line-height: 1.68;
  }

  .au-bio em {
    color: var(--text-soft);
  }

  .about-stats {
    padding-top: clamp(80px, 10vw, 140px);
  }

  @media (max-width: 860px) {
    .about-profile__portrait {
      max-width: 460px;
    }
  }
</style>
