---
import FaqArticlePage from '../../components/FaqArticlePage.astro';

const pageUrl = 'https://www.nigredo.ch/haeufige-fragen/kann-eine-anwendung-vollstaendig-lokal-betrieben-werden/';
const question = 'Können meine Daten vollständig lokal bleiben?';
const answer = 'Ja, sofern die Aufgabe und die gewünschten Funktionen dies zulassen. Eine lokale Anwendung verarbeitet Daten auf dem Gerät oder innerhalb deiner eigenen Infrastruktur. Sensible Inhalte müssen dadurch nicht zwingend an externe Server oder Dienste aus der Cloud übertragen werden.';
const title = 'Können Daten vollständig lokal bleiben? | Nigredo';
const description = 'Wann Anwendungen Daten vollständig lokal verarbeiten können, wo technische Grenzen liegen und welche Architektur sensible Inhalte schützt.';

const sections = [
  {
    id: 'lokal',
    title: 'Was lokale Verarbeitung bedeutet',
    paragraphs: [
      'Die Anwendung läuft auf einem einzelnen Gerät, in einem internen Netzwerk oder auf deiner eigenen Infrastruktur. Daten und Verarbeitung bleiben dort, statt für jeden Arbeitsschritt an externe Dienste übertragen zu werden.',
    ],
  },
  {
    id: 'geeignet',
    title: 'Welche Aufgaben sich dafür eignen',
    paragraphs: [
      'Lokale Wissenssysteme, Auswertungen, Dashboards, Dokumentenverarbeitung und bestimmte KI-Funktionen lassen sich häufig ohne öffentliche Cloud umsetzen. Besonders interessant ist das, wenn sensible Informationen verarbeitet werden oder eine Organisation möglichst unabhängig bleiben möchte.',
    ],
  },
  {
    id: 'grenzen',
    title: 'Wo lokale Lösungen Grenzen haben',
    paragraphs: [
      'Einige Funktionen benötigen aktuelle externe Daten, hohe Rechenleistung, gemeinsame Zugriffe über mehrere Standorte oder Dienste, die nur online angeboten werden. Lokal ist deshalb kein Selbstzweck. Die Architektur muss zur Aufgabe, zum Betrieb und zum Budget passen.',
    ],
  },
  {
    id: 'entscheidung',
    title: 'Wie ich die passende Architektur bestimme',
    paragraphs: [
      'Auch eine lokale Anwendung braucht ein Konzept für Zugriffsrechte, Sicherungen, Aktualisierungen und Verantwortlichkeiten. Ohne diese Punkte wäre die Cloud zwar draussen, die Betriebsfrage aber noch immer im Raum.',
      'Ich prüfe Datenarten, Funktionen, Nutzer, Infrastruktur und Wartungsbedarf. Daraus entsteht eine nachvollziehbare Empfehlung: vollständig lokal, gezielt hybrid oder online, aber so sparsam und kontrolliert wie möglich.',
    ],
  },
];

const relatedQuestions = [
  {
    href: '/haeufige-fragen/was-muss-meine-website-beim-datenschutz-beachten/',
    title: 'Was muss meine Website beim Datenschutz beachten?',
    text: 'Welche Datenflüsse, Zugriffsrechte und externen Dienste wichtig sind.',
  },
  {
    href: '/haeufige-fragen/wem-gehoeren-code-daten-und-zugaenge/',
    title: 'Behalte ich die Kontrolle über Code, Daten und Zugänge?',
    text: 'Wie Kontrolle, Rechte und Abhängigkeiten geregelt werden.',
  },
  {
    href: '/haeufige-fragen/was-bedeuten-mehrere-hundert-ki-agenten/',
    title: 'Arbeiten wirklich Hunderte KI-Agenten an meinem Projekt?',
    text: 'Wie KI-Abläufe ausgewählt, geführt und kontrolliert werden.',
  },
  {
    href: '/haeufige-fragen/arbeitest-du-allein/',
    title: 'Arbeitest du allein?',
    text: 'Wer technische Entscheidungen trifft und Verantwortung übernimmt.',
  },
];
---

<FaqArticlePage
  {pageUrl}
  {question}
  {answer}
  {title}
  {description}
  {sections}
  {relatedQuestions}
