---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ContactForm from '../components/ContactForm.astro';

const pageUrl = 'https://www.nigredo.ch/kontakt/';
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.nigredo.ch/" },
        { "@type": "ListItem", "position": 2, "name": "Kontakt", "item": pageUrl }
      ]
    },
    {
      "@type": "ContactPage",
      "@id": `${pageUrl}#webpage`,
      "name": "Projekt besprechen | Nigredo St. Gallen",
      "url": pageUrl,
      "description": "Besprich deine Website, Software oder digitale Aufgabe direkt mit Marco Calzavara. Auch ein erster Gedanke oder eine offene Frage genügen.",
      "inLanguage": "de-CH",
      "datePublished": "2025-06-01",
      "dateModified": "2026-10-28T12:00:00+01:00",
      "isPartOf": { "@id": "https://www.nigredo.ch/#website" },
      "publisher": { "@id": "https://www.nigredo.ch/#organization" },
      "breadcrumb": { "@id": `${pageUrl}#breadcrumb` },
      "isAccessibleForFree": true,
      "mainEntity": { "@id": "https://www.nigredo.ch/#organization" }
    }
  ]
});
---

<Layout
  title="Kontakt: Projekt besprechen | Nigredo St. Gallen"
  description="Besprich deine Website, Software oder digitale Aufgabe direkt mit Marco Calzavara. Auch ein erster Gedanke oder eine offene Frage genügen."
  canonical={pageUrl}
  ogTitle="Bring mir die Idee. Sie darf noch Ecken haben."
  ogDescription="Ein konkreter Auftrag, ein erster Gedanke oder ein Ablauf, der besser werden sollte: Alles ist ein guter Anfang."
  ogImageAlt="Nigredo Kontakt: direkter Austausch mit Marco Calzavara"
  twitterTitle="Bring mir die Idee | Nigredo"
  twitterDescription="Auch ein erster Gedanke oder eine offene Frage genügen."
  schema={schema}
>
  <section class="page-hero contact-hero" aria-labelledby="kontakt-title">
    <div class="container">
      <Breadcrumb items={[
        { label: 'Start', href: '/' },
        { label: 'Kontakt' }
      ]} />
      <h1 id="kontakt-title" class="page-hero__title fade-up">
        Bring mir die Idee.<br>
        <span class="gradient-text">Sie darf noch Ecken haben.</span>
      </h1>
      <div class="page-hero__row fade-up delay-100">
        <p class="page-hero__lead">
          Vielleicht hast du bereits einen konkreten Auftrag. Vielleicht erst einen unfertigen Gedanken oder einen Ablauf, der unnötig Nerven kostet. Alles ist ein guter Anfang. Schreib mir, was entstehen soll oder wo es heute hakt. Ich prüfe dein Vorhaben persönlich und antworte mit einer ehrlichen ersten Einschätzung.
        </p>
      </div>
    </div>
  </section>

  <section class="contact-form-section" aria-label="Kontaktformular">
    <div class="contact-form-section__glow" aria-hidden="true"></div>
    <div class="container">
      <div class="contact-form-wrap fade-up delay-100">
        <ContactForm />
      </div>
    </div>
  </section>
</Layout>

<style>
  :global(body) {
    --page-accent-a: var(--contact-neon-a);
    --page-accent-b: var(--contact-neon-b);
    --page-accent-c: var(--contact-neon-c);
    --page-accent: var(--contact-neon-c);
    --page-title-gradient: linear-gradient(
      102deg in oklab,
      var(--page-accent-a) 0%,
      var(--page-accent-c) 50%,
      var(--page-accent-b) 100%
    );
  }

  .contact-hero {
    --contact-a: var(--contact-neon-a);
    --contact-b: var(--contact-neon-b);
    --contact-c: var(--contact-neon-c);
  }

  .contact-form-section {
    position: relative;
    overflow-x: clip;
    padding: clamp(64px, 8vw, 104px) 0 clamp(110px, 12vw, 170px);
  }

  .contact-form-section__glow {
    position: absolute;
    left: 50%;
    top: 0;
    width: min(1000px, 100vw);
    aspect-ratio: 2 / 1;
    transform: translateX(-50%);
    background:
      radial-gradient(45% 55% at 35% 50%, color-mix(in oklab, var(--page-accent-a) 22%, transparent), transparent 70%),
      radial-gradient(45% 55% at 65% 50%, color-mix(in oklab, var(--page-accent-b) 22%, transparent), transparent 70%);
    filter: blur(70px);
    pointer-events: none;
  }

  .contact-form-wrap {
    position: relative;
    width: min(100%, 820px);
    margin: 0 auto;
    --contact-a: var(--contact-neon-a);
    --contact-b: var(--contact-neon-b);
    --contact-c: var(--contact-neon-c);
  }
</style>
