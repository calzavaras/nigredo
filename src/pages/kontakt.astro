---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ContactForm from '../components/ContactForm.astro';

const pageUrl = 'https://www.nigredo.ch/kontakt/';
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.nigredo.ch/" },
        { "@type": "ListItem", "position": 2, "name": "Kontakt", "item": pageUrl }
      ]
    },
    {
      "@type": "ContactPage",
      "@id": `${pageUrl}#webpage`,
      "name": "Projekt besprechen | Nigredo St. Gallen",
      "url": pageUrl,
      "description": "Besprich deine Idee, Website, KI-Lösung oder digitale Anwendung direkt mit Marco Calzavara. Auch ein erster Gedanke oder eine offene Frage genügen.",
      "inLanguage": "de-CH",
      "datePublished": "2025-06-01",
      "dateModified": "2026-07-30",
      "isPartOf": { "@id": "https://www.nigredo.ch/#website" },
      "publisher": { "@id": "https://www.nigredo.ch/#organization" },
      "breadcrumb": { "@id": `${pageUrl}#breadcrumb` },
      "isAccessibleForFree": true,
      "mainEntity": { "@id": "https://www.nigredo.ch/#organization" }
    }
  ]
});
---

<Layout
  title="Projekt besprechen | Nigredo St. Gallen"
  description="Besprich deine Idee, Website, KI-Lösung oder digitale Anwendung direkt mit Marco Calzavara. Auch ein erster Gedanke oder eine offene Frage genügen."
  canonical={pageUrl}
  ogTitle="Bring mir die Idee. Sie darf noch Ecken haben."
  ogDescription="Ein konkreter Auftrag, ein erster Gedanke oder ein Ablauf, der besser funktionieren sollte: Beides ist ein guter Anfang."
  ogImageAlt="Nigredo Kontakt: direkter Austausch mit Marco Calzavara"
  twitterTitle="Bring mir die Idee | Nigredo"
  twitterDescription="Auch ein erster Gedanke oder eine offene Frage genügen."
  schema={schema}
>
  <section class="section pt-sub contact-hero" aria-labelledby="kontakt-title">
    <div class="container">

      <Breadcrumb items={[
        { label: 'Start', href: '/' },
        { label: 'Kontakt' }
      ]} />

      <div class="kontakt-grid">

        <div class="fade-up contact-hero__content">
          <h1 id="kontakt-title" class="contact-hero__title">
            Bring mir die Idee.<br>
            <span class="gradient-text">Sie darf noch Ecken haben.</span>
          </h1>
          <p class="hero-lead contact-hero__lead">
            Vielleicht hast du bereits einen konkreten Auftrag. Vielleicht erst den Gedanken: «Eigentlich müsste man doch …» Beides ist ein guter Anfang. Schreib mir, was entstehen soll, wo es heute hakt oder was künftig besser funktionieren könnte. Ich prüfe dein Vorhaben persönlich und antworte mit einer ehrlichen ersten Einschätzung.
          </p>
        </div>

        <div class="contact-form-wrap fade-up delay-100">
          <ContactForm />
        </div>

      </div>

    </div>
  </section>
</Layout>

<style>
  :global(body) {
    --page-accent-a: var(--contact-neon-a);
    --page-accent-b: var(--contact-neon-b);
    --page-accent: var(--contact-neon-b);
  }

  .contact-hero {
    --contact-a: var(--contact-neon-a);
    --contact-b: var(--contact-neon-b);
    --contact-c: var(--contact-neon-b);
    animation: none;
  }

  .contact-hero {
    padding-top: var(--hero-offset-top-breadcrumb);
    padding-bottom: var(--section-py-md);
  }

  .contact-hero :global(.breadcrumb) {
    margin-bottom: 28px;
  }

  .contact-hero .badge {
    margin-bottom: 0.95rem;
    color: color-mix(in srgb, var(--contact-a) 72%, white 28%);
    border-color: color-mix(in srgb, var(--contact-b) 36%, rgba(255, 255, 255, 0.22));
    background: transparent;
    box-shadow: none;
  }

  .kontakt-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(44px, 5vw, 64px);
  }

  .contact-hero__content {
    max-width: 940px;
  }

  .contact-hero__title {
    max-width: 940px;
    font-size: var(--hero-title-size);
    line-height: var(--hero-title-line-height);
    letter-spacing: -0.02em;
    margin-bottom: clamp(24px, 3vw, 30px);
  }

  .contact-hero .gradient-text {
    background: linear-gradient(96deg, var(--contact-a) 0%, var(--contact-b) 100%);
    background-size: 100% auto;

    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .contact-hero__lead {
    max-width: 620px;
    font-size: var(--lead-size);
    line-height: 1.65;
  }

  .contact-form-wrap {
    width: min(100%, 780px);
    min-width: 0;
  }

  @media (max-width: 980px) {
    .contact-hero {
      padding-top: var(--hero-offset-top-breadcrumb-mobile);
      padding-bottom: 72px;
    }

    .kontakt-grid {
      gap: 38px;
    }

    .contact-hero__title {
      font-size: var(--hero-title-size-tablet);
      line-height: var(--hero-title-line-height-mobile);
      letter-spacing: 0;
    }
  }

  @media (max-width: 520px) {
    .contact-hero {
      padding-top: var(--hero-offset-top-breadcrumb-mobile);
      padding-bottom: 72px;
    }

    .contact-hero__title {
      font-size: var(--hero-title-size-mobile);
      line-height: var(--hero-title-line-height-mobile);
      letter-spacing: 0;
    }

    .contact-hero__lead {
      font-size: var(--lead-size-mobile);
      line-height: 1.6;
    }

  }
</style>
