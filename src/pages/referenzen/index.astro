---
import Layout from '../../layouts/Layout.astro';
import ReferencesArchiveSection from '../../components/ReferencesArchiveSection.astro';
import { getReferencePage, getReferencePageCount } from '../../data/references';

const pageNumber = 1;
const pageCount = getReferencePageCount();
const pageItems = getReferencePage(pageNumber);
const pageUrl = 'https://www.nigredo.ch/referenzen/';
const nextUrl = pageCount > 1 ? 'https://www.nigredo.ch/referenzen/seite/2/' : undefined;

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Start', item: 'https://www.nigredo.ch/' },
        { '@type': 'ListItem', position: 2, name: 'Referenzen', item: pageUrl },
      ],
    },
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: 'Referenzen: Websites, Software und KI | Nigredo',
      description: 'Ausgewählte Websites, Wissenssysteme, lokale Anwendungen und Software mit KI von Nigredo. Mit Aufgabe, Umsetzung und Ergebnis.',
      inLanguage: 'de-CH',
      datePublished: '2025-06-01',
      dateModified: '2026-09-09T22:00:00+02:00',
      isPartOf: { '@id': 'https://www.nigredo.ch/#website' },
      publisher: { '@id': 'https://www.nigredo.ch/#organization' },
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
      isAccessibleForFree: true,
      about: { '@id': 'https://www.nigredo.ch/#organization' },
      mentions: [
        {
          '@type': ['WebSite', 'CreativeWork'],
          '@id': 'https://www.nigredo.ch/referenzen/simona-mueller/#website-project',
          name: 'Website für Simona Müller',
          url: 'https://www.nigredo.ch/referenzen/simona-mueller/',
          creator: { '@id': 'https://www.nigredo.ch/#person' },
        },
        {
          '@type': 'WebSite',
          '@id': 'https://www.nigredo.ch/referenzen/happypath/#website-project',
          name: 'Website für HappyPath GmbH',
          url: 'https://www.nigredo.ch/referenzen/happypath/',
          description: 'Dreisprachige Website für HappyPath und TextRoom, eine Software für Schweizer IV-Stellen.',
          creator: { '@id': 'https://www.nigredo.ch/#person' },
        },
        {
          '@type': 'SoftwareApplication',
          '@id': 'https://www.nigredo.ch/referenzen/mentra/#project',
          name: 'Mentra Video-Wissenssystem',
          url: 'https://www.nigredo.ch/referenzen/mentra/',
          applicationCategory: 'BusinessApplication',
          creator: { '@id': 'https://www.nigredo.ch/#person' },
        },
        {
          '@type': 'SoftwareApplication',
          '@id': 'https://www.nigredo.ch/referenzen/ki-voice-agent/#project',
          name: 'KI Voice Agent für IV-Stellen',
          url: 'https://www.nigredo.ch/referenzen/ki-voice-agent/',
          applicationCategory: 'BusinessApplication',
          creator: { '@id': 'https://www.nigredo.ch/#person' },
        },
        {
          '@type': 'SoftwareApplication',
          '@id': 'https://www.nigredo.ch/referenzen/dashboard-kantonsverwaltung/#project',
          name: 'Dashboard für Kantonsverwaltung',
          url: 'https://www.nigredo.ch/referenzen/dashboard-kantonsverwaltung/',
          applicationCategory: 'BusinessApplication',
          creator: { '@id': 'https://www.nigredo.ch/#person' },
        },
        {
          '@type': ['WebSite', 'CreativeWork'],
          '@id': 'https://www.nigredo.ch/referenzen/therapie-ost/#website-project',
          name: 'Website für Therapie Ost',
          url: 'https://www.nigredo.ch/referenzen/therapie-ost/',
          creator: { '@id': 'https://www.nigredo.ch/#person' },
        },
        {
          '@type': ['WebSite', 'CreativeWork'],
          '@id': 'https://www.nigredo.ch/referenzen/plan-h/#website-project',
          name: 'Website für Plan H Hypnosetherapie',
          url: 'https://www.nigredo.ch/referenzen/plan-h/',
          creator: { '@id': 'https://www.nigredo.ch/#person' },
        },
        {
          '@type': 'SoftwareApplication',
          '@id': 'https://www.nigredo.ch/referenzen/thinktank/#project',
          name: 'ThinkTank Wissensplattform',
          url: 'https://www.nigredo.ch/referenzen/thinktank/',
          applicationCategory: 'BusinessApplication',
          creator: { '@id': 'https://www.nigredo.ch/#person' },
        },
      ],
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: pageItems.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          url: `https://www.nigredo.ch${item.href}`,
          name: item.listTitle,
        })),
      },
    },
  ],
});
---

<Layout
  title="Referenzen: Websites, Software und KI | Nigredo"
  description="Ausgewählte Websites, Wissenssysteme, lokale Anwendungen und Software mit KI von Nigredo. Mit Aufgabe, Umsetzung und Ergebnis."
  canonical={pageUrl}
  ogTitle="Nicht nur gedacht. Wirklich gemacht. | Nigredo"
  ogDescription="Websites, Wissenssysteme und digitale Werkzeuge, die aus konkreten Anforderungen entstanden sind und im Alltag ihren Job machen."
  ogImageAlt="Nigredo Referenzen mit echten Projekten"
  twitterTitle="Nicht nur gedacht. Wirklich gemacht. | Nigredo"
  twitterDescription="Ausgewählte Websites, Software und digitale Werkzeuge aus St. Gallen."
  schema={schema}
  nextUrl={nextUrl}
>
  <ReferencesArchiveSection pageNumber={pageNumber} pageCount={pageCount} pageItems={pageItems} />
</Layout>
