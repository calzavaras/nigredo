---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const pageUrl = 'https://www.nigredo.ch/digitale-loesungen/';
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.nigredo.ch/" },
        { "@type": "ListItem", "position": 2, "name": "Lösungen", "item": pageUrl }
      ]
    },
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      "url": pageUrl,
      "name": "Websites, KI und digitale Produkte | Nigredo St. Gallen",
      "description": "Individuelle Websites, KI-Systeme, lokale Anwendungen, Backends, digitale Werkzeuge, Logos und Inhalte für konkrete Aufgaben.",
      "inLanguage": "de-CH",
      "datePublished": "2025-06-01",
      "dateModified": "2026-07-30",
      "isPartOf": { "@id": "https://www.nigredo.ch/#website" },
      "publisher": { "@id": "https://www.nigredo.ch/#organization" },
      "breadcrumb": { "@id": `${pageUrl}#breadcrumb` },
      "isAccessibleForFree": true,
      "mainEntity": { "@id": `${pageUrl}#services` }
    },
    {
      "@type": "ItemList",
      "@id": `${pageUrl}#services`,
      "name": "Leistungen",
      "description": "Websites, KI-Systeme, Anwendungen, Backends, Marken und Inhalte aus einer Hand",
      "numberOfItems": 3,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "item": {
            "@type": "Service",
            "@id": `${pageUrl}#website`,
            "name": "Websites mit klarer Aufgabe",
            "description": "Individuelle Websites, die Orientierung geben, Vertrauen schaffen und Menschen gezielt zur nächsten Handlung führen.",
            "serviceType": "Webentwicklung",
            "provider": { "@id": "https://www.nigredo.ch/#organization" },
            "brand": { "@id": "https://www.nigredo.ch/#brand" },
            "areaServed": [
              { "@type": "Country", "name": "Schweiz" },
              { "@type": "AdministrativeArea", "name": "Kanton St. Gallen" },
              { "@type": "AdministrativeArea", "name": "Kanton Thurgau" },
              { "@type": "AdministrativeArea", "name": "Kanton Appenzell Ausserrhoden" },
              { "@type": "AdministrativeArea", "name": "Kanton Appenzell Innerrhoden" },
              { "@type": "AdministrativeArea", "name": "Kanton Zürich" }
            ],
            "offers": {
              "@type": "Offer",
              "priceCurrency": "CHF",
              "priceSpecification": { "@type": "UnitPriceSpecification", "description": "Fixpreis" }
            }
          }
        },
        {
          "@type": "ListItem",
          "position": 2,
          "item": {
            "@type": "Service",
            "@id": `${pageUrl}#ki`,
            "name": "KI-Lösungen für KMU",
            "description": "Digitale Werkzeuge und KI-Lösungen, die wiederkehrende Arbeit vereinfachen, Wissen nutzbar machen und im Alltag verlässlich funktionieren.",
            "serviceType": "KI-Lösungen",
            "provider": { "@id": "https://www.nigredo.ch/#organization" },
            "brand": { "@id": "https://www.nigredo.ch/#brand" },
            "areaServed": [
              { "@type": "Country", "name": "Schweiz" },
              { "@type": "AdministrativeArea", "name": "Kanton St. Gallen" },
              { "@type": "AdministrativeArea", "name": "Kanton Thurgau" },
              { "@type": "AdministrativeArea", "name": "Kanton Appenzell Ausserrhoden" },
              { "@type": "AdministrativeArea", "name": "Kanton Appenzell Innerrhoden" },
              { "@type": "AdministrativeArea", "name": "Kanton Zürich" }
            ]
          }
        },
        {
          "@type": "ListItem",
          "position": 3,
          "item": {
            "@type": "Service",
            "@id": `${pageUrl}#content`,
            "name": "Inhalte, die Entscheidungen erleichtern",
            "description": "Klare Texte, passende Bilder und eine präzise Struktur, die komplexe Angebote verständlich und glaubwürdig vermitteln.",
            "serviceType": "Content-Erstellung",
            "provider": { "@id": "https://www.nigredo.ch/#organization" },
            "brand": { "@id": "https://www.nigredo.ch/#brand" },
            "areaServed": [
              { "@type": "Country", "name": "Schweiz" },
              { "@type": "AdministrativeArea", "name": "Kanton St. Gallen" },
              { "@type": "AdministrativeArea", "name": "Kanton Thurgau" },
              { "@type": "AdministrativeArea", "name": "Kanton Appenzell Ausserrhoden" },
              { "@type": "AdministrativeArea", "name": "Kanton Appenzell Innerrhoden" },
              { "@type": "AdministrativeArea", "name": "Kanton Zürich" }
            ]
          }
        }
      ]
    }
  ]
});
---

<Layout
  title="Websites, KI und digitale Produkte | Nigredo St. Gallen"
  description="Individuelle Websites, KI-Systeme, lokale Anwendungen, Backends, digitale Werkzeuge, Logos und Inhalte für konkrete Aufgaben."
  canonical={pageUrl}
  ogTitle="Aus «Man müsste mal» wird etwas, das funktioniert."
  ogDescription="Websites, KI-Systeme, lokale Anwendungen, Backends, Marken und Inhalte als zusammenhängende digitale Produkte."
  ogImageAlt="Nigredo: individuelle Websites, KI-Lösungen und digitale Werkzeuge"
  twitterTitle="Websites, KI und digitale Produkte | Nigredo"
  twitterDescription="Entwickelt für konkrete Aufgaben statt für möglichst viele Funktionen."
  schema={schema}
>
  <section class="section pt-sub solutions-hero" aria-labelledby="loesungen-title">
    <div class="container solutions-hero__container">

      <Breadcrumb items={[
        { label: 'Start', href: '/' },
        { label: 'Lösungen' }
      ]} />

      <div class="fade-up home-hero__inner solutions-hero__content">

        <h1 id="loesungen-title" class="home-hero__title solutions-hero__title">
          <span class="solutions-hero__line">Aus «Man müsste</span>
          <span class="solutions-hero__line">mal» <span class="gradient-text">wird etwas,</span></span>
          <span class="gradient-text solutions-hero__line">das funktioniert.</span>
        </h1>
        <p class="hero-lead solutions-hero__lead">
          Ich entwickle digitale Produkte für Aufgaben, die Standardlösungen nicht überzeugend abdecken. Websites, KI-Systeme, lokale Anwendungen, Backends, Marken und Inhalte denke ich als zusammenhängendes Produkt, bei dem Aussage, Bedienung, Gestaltung und Technik dieselbe Richtung verfolgen. KI schafft mehr Varianten und kürzere Wege. Mein Urteil gibt dem Ergebnis Richtung.
        </p>
      </div>

      <div class="fade-up delay-100 solutions-fields" role="list" aria-label="Leistungsfelder">
        <article class="solutions-field solutions-field--web" role="listitem">
          <div class="solutions-field__head">
            <span class="solutions-field__signal" aria-hidden="true">
              <svg width="30" height="30" viewBox="0 0 24 24" fill="none">
                <rect x="3" y="4" width="18" height="15" rx="2.4" stroke="currentColor" stroke-width="1.6"/>
                <path d="M3 8H21M7 13.4L10.1 10.3L12.6 12.7L17.2 9.4M15.6 9.2H17.4V11" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <h3>Websites, die nicht nur herumstehen.</h3>
          </div>
          <div class="solutions-field__content">
            <p class="solutions-field__lead">Eine gute Website ist keine digitale Broschüre, die man einmal veröffentlicht und anschliessend höflich ignoriert. Sie erklärt dein Angebot, zeigt deine Haltung, schafft Vertrauen und führt Menschen selbstverständlich zum nächsten Schritt.</p>
            <div class="solutions-field__details">
              <p>Ich entwickle individuelle Websites für Selbstständige, KMU, Organisationen und anspruchsvolle Fachbereiche. Je nach Aufgabe reicht das von einer fokussierten Unternehmensseite bis zu einer Plattform mit Backend, Login, Datenbank, Schnittstellen oder eigener Inhaltsverwaltung.</p>
              <p>Dazu gehören Positionierung, Seitenstruktur, Texte, individuelles Design, technische Umsetzung, Performance, Barrierearmut, Suchmaschinenbasis, Datenschutz, Sicherheit und passende Funktionen. Das technische System richtet sich nach der Aufgabe. Nicht umgekehrt.</p>
            </div>
          </div>
        </article>

        <article class="solutions-field solutions-field--systems" role="listitem">
          <div class="solutions-field__head">
            <span class="solutions-field__signal" aria-hidden="true">
              <svg width="30" height="30" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="2" stroke="currentColor" stroke-width="1.7"/>
                <circle cx="4.5" cy="8" r="1.5" stroke="currentColor" stroke-width="1.4"/>
                <circle cx="4.5" cy="16" r="1.5" stroke="currentColor" stroke-width="1.4"/>
                <circle cx="19.5" cy="8" r="1.5" stroke="currentColor" stroke-width="1.4"/>
                <circle cx="19.5" cy="16" r="1.5" stroke="currentColor" stroke-width="1.4"/>
                <circle cx="12" cy="3" r="1.5" stroke="currentColor" stroke-width="1.4"/>
                <path d="M10.3 11L6 8.7M10.3 13L6 15.3M13.7 11L18 8.7M13.7 13L18 15.3M12 10V4.5" stroke="currentColor" stroke-width="1.15"/>
              </svg>
            </span>
            <h3>KI und Software mit einem echten Grund.</h3>
          </div>
          <div class="solutions-field__content">
            <p class="solutions-field__lead">KI ist kein Pflichtprogramm. Sie ist ein Werkzeug. Und wie bei jedem Werkzeug entscheidet die Aufgabe, ob ihr Einsatz sinnvoll ist.</p>
            <div class="solutions-field__details">
              <p>Ich entwickle KI-Assistenten, Wissenssysteme, Automatisierungen, lokale Anwendungen, Dashboards und digitale Werkzeuge, die konkrete Arbeitsschritte verbessern. Sie erschliessen Wissen aus Dokumenten oder Videos, durchsuchen interne Informationen, werten Daten aus, beantworten Fachfragen anhand eigener Quellen oder bilden komplexe Abläufe in einer einfachen Oberfläche ab.</p>
              <p>Mehrere hundert spezialisierte KI-Agenten unterstützen Recherche, Konzeption, Text, Gestaltung, Entwicklung, Tests und Qualitätssicherung. Sie liefern Möglichkeiten. Ich bestimme die Richtung, prüfe die Ergebnisse und führe alles zu einem funktionierenden Produkt zusammen. Schnell bedeutet dabei nicht oberflächlich, sondern weniger Leerlauf und kürzere Wege zwischen Vorstellung und Umsetzung.</p>
            </div>
          </div>
        </article>

        <article class="solutions-field solutions-field--identity" role="listitem">
          <div class="solutions-field__head">
            <span class="solutions-field__signal" aria-hidden="true">
              <svg width="30" height="30" viewBox="0 0 24 24" fill="none">
                <rect x="4" y="4" width="16" height="16" rx="2.4" stroke="currentColor" stroke-width="1.6"/>
                <path d="M7.2 8.1H13.2M7.2 11.3H11.6M7.2 15.9L9.8 13.4L11.6 15.1L16.8 9.9M15.1 9.8H16.9V11.6" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <h3>Ideen brauchen eine Form, die man versteht und behält.</h3>
          </div>
          <div class="solutions-field__content">
            <p class="solutions-field__lead">Ein gutes digitales Produkt beginnt nicht beim Code. Es beginnt bei der Frage, was Menschen sehen, verstehen und fühlen sollen.</p>
            <div class="solutions-field__details">
              <p>Ich entwickle Namen, Logos, Texte, Bildwelten, Inhaltsstrukturen und visuelle Identitäten, die einem Vorhaben ein klares Gesicht geben. Dazu gehören Positionierung, Kernbotschaft, Navigation, Benutzerführung, mehrsprachige Inhalte und die verständliche Darstellung komplexer Themen.</p>
              <p>Es geht nicht darum, etwas lediglich schöner zu machen. Es geht darum, eine Idee so klar in Form zu bringen, dass sie verstanden wird und im Kopf bleibt.</p>
            </div>
          </div>
        </article>
      </div>

      <section class="solutions-process fade-up" aria-labelledby="solutions-process-title">
        <div class="solutions-process__intro">
          <p class="solutions-process__label">Zusammenarbeit</p>
          <h2 id="solutions-process-title">Vom Gedanken zum Produkt. Ohne unnötige Ehrenrunde.</h2>
        </div>
        <ol class="solutions-process__steps">
          <li>
            <span>01</span>
            <div><strong>Erst zuhören. Dann weiterdenken.</strong><p>Wir klären, was entstehen oder besser funktionieren soll, wer das Produkt nutzt und woran ein gutes Ergebnis erkennbar ist. Eine klare Schwierigkeit oder eine gute Idee reichen als Anfang.</p></div>
          </li>
          <li>
            <span>02</span>
            <div><strong>Möglichkeiten prüfen. Klar entscheiden.</strong><p>Ich strukturiere die Aufgabe, entwickle sinnvolle Varianten und zeige dir, welcher Weg überzeugt. Du erhältst einen verständlichen Vorschlag mit Umfang, Prioritäten, Fixpreis und realistischem Zeitrahmen.</p></div>
          </li>
          <li>
            <span>03</span>
            <div><strong>Früh sichtbar. Sauber fertig.</strong><p>Ich texte, gestalte, entwickle und teste. Wo es sinnvoll ist, entstehen früh funktionierende Versionen, damit wir nicht wochenlang über etwas sprechen, das man längst ausprobieren könnte.</p></div>
          </li>
        </ol>
      </section>

    </div>
  </section>

  <section class="section solutions-final-section" aria-labelledby="loesungen-cta-title">
    <div class="container">
      <div class="section-cta solutions-final-cta fade-up">
        <span class="cta-label">Nächster Schritt</span>
        <h2 id="loesungen-cta-title">Was sollte längst<br><span>einfacher funktionieren?</span></h2>
        <p>Du musst die Lösung noch nicht kennen. Beschreibe, was heute zu viel Zeit, Klarheit oder Nerven kostet. Gemeinsam prüfen wir, welcher nächste Schritt wirklich hilft.</p>
        <div class="hero-cta-group" style="justify-content: center;">
          <a href="/kontakt/" class="btn btn-primary">Projekt besprechen</a>
          <a href="/referenzen/" class="btn btn-ghost">Referenzen ansehen</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  :global(body) {
    --page-accent-a: var(--solutions-neon-a);
    --page-accent-b: var(--solutions-neon-b);
    --page-accent: var(--solutions-neon-b);
  }

  .solutions-hero,
  .solutions-fields,
  .solutions-final-section {
    --solutions-a: var(--solutions-neon-a);
    --solutions-b: var(--solutions-neon-b);
    --solutions-c: color-mix(in oklab, var(--solutions-neon-a) 42%, var(--solutions-neon-b));
    --page-accent: var(--solutions-b);
    animation: none;
  }

  .solutions-hero {
    min-height: min(620px, 68vh);
    display: flex;
    align-items: center;
    padding-top: var(--hero-offset-top-breadcrumb);
    padding-bottom: var(--hero-offset-bottom);
  }

  .solutions-hero__container {
    position: relative;
    width: 100%;
  }

  .solutions-hero__content {
    max-width: 940px;
  }

  .solutions-hero .home-hero__inner {
    width: 100%;
  }

  .solutions-hero :global(.breadcrumb) {
    margin-bottom: 28px;
  }

  .solutions-hero .badge {
    margin-bottom: 0.95rem;
    color: rgba(226, 255, 252, 0.94);
    border-color: color-mix(in srgb, var(--solutions-b) 34%, rgba(255, 255, 255, 0.2));
    background: transparent;
    box-shadow: none;
  }

  .solutions-hero__title {
    max-width: 940px;
    font-size: clamp(3.05rem, 5.35vw, 4.9rem);
    line-height: var(--hero-title-line-height);
    letter-spacing: -0.04em;
    margin-bottom: clamp(24px, 3vw, 30px);
  }

  .solutions-hero__line {
    display: block;
  }

  .solutions-hero .gradient-text {
    background: var(--page-title-gradient);
    background-size: 100% auto;

    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .solutions-hero__lead {
    max-width: 620px;
    font-size: var(--lead-size);
    line-height: 1.65;
  }

  .solutions-fields {
    display: grid;
    margin-top: clamp(72px, 8vw, 96px);
    border-top: 1px solid rgba(255, 255, 255, 0.11);
    overflow: clip;
  }

  .solutions-field {
    --field-color: var(--solutions-a);
    display: grid;
    grid-template-columns: minmax(250px, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(40px, 7vw, 88px);
    position: relative;
    padding: clamp(54px, 7vw, 82px) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.11);
    isolation: isolate;
  }

  .solutions-field--systems {
    --field-color: var(--solutions-b);
  }

  .solutions-field--identity {
    --field-color: var(--solutions-c);
  }

  .solutions-field::before {
    content: "";
    position: absolute;
    inset: 14% -8% 12% 50%;
    z-index: -1;
    background: radial-gradient(circle at center, color-mix(in srgb, var(--field-color) 9%, transparent), transparent 68%);
    opacity: 0.55;
    pointer-events: none;
    transition: opacity 0.5s var(--ease-spring), transform 0.5s var(--ease-spring);
  }

  .solutions-field:hover::before {
    opacity: 0.9;
    transform: translateX(-2%);
  }

  .solutions-field__head {
    align-self: start;
    position: relative;
    padding-top: 4px;
  }

  .solutions-field__signal {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin-bottom: 28px;
    color: color-mix(in srgb, var(--field-color) 88%, white 10%);
    border: 1px solid color-mix(in srgb, var(--field-color) 34%, rgba(255, 255, 255, 0.12));
    border-radius: 50%;
    background: color-mix(in srgb, var(--field-color) 7%, transparent);
    transition: transform 0.45s var(--ease-spring), background-color 0.45s ease;
  }

  .solutions-field:hover .solutions-field__signal {
    transform: rotate(-5deg) scale(1.04);
    background: color-mix(in srgb, var(--field-color) 12%, transparent);
  }

  .solutions-field__signal::after {
    content: "";
    position: absolute;
    top: 35px;
    left: 72px;
    width: clamp(44px, 7vw, 82px);
    height: 1px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--field-color) 58%, transparent), transparent);
  }

  .solutions-field__head h3 {
    max-width: 13ch;
    margin: 0;
    color: #f5f5f7;
    font-size: clamp(1.85rem, 3.25vw, 2.8rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .solutions-field__content {
    min-width: 0;
  }

  .solutions-field__lead {
    max-width: 31ch;
    margin: 0 0 clamp(30px, 4vw, 42px);
    color: rgba(245, 245, 247, 0.92);
    font-size: clamp(1.22rem, 2vw, 1.55rem);
    font-weight: 500;
    line-height: 1.42;
    letter-spacing: -0.012em;
    text-wrap: pretty;
  }

  .solutions-field__details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 42px);
  }

  .solutions-field__details p {
    max-width: 36ch;
    margin: 0;
    color: var(--text-body);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .solutions-process {
    display: grid;
    grid-template-columns: minmax(240px, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(40px, 7vw, 88px);
    margin-top: clamp(92px, 10vw, 132px);
    padding: var(--section-py-sm) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .solutions-process__label {
    margin: 0 0 14px;
    color: color-mix(in srgb, var(--solutions-a) 82%, white 8%);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .solutions-process__intro h2 {
    max-width: 12ch;
    margin: 0;
    font-size: var(--display-title);
    line-height: 1.05;
  }

  .solutions-process__steps {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .solutions-process__steps li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 18px;
    padding: 22px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .solutions-process__steps li:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .solutions-process__steps li > span {
    color: rgba(255, 255, 255, 0.38);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .solutions-process__steps strong {
    display: block;
    margin-bottom: 6px;
    color: #fff;
    font-size: 1.12rem;
  }

  .solutions-process__steps p {
    max-width: 48ch;
    margin: 0;
    color: var(--text-soft);
    line-height: 1.62;
  }

  .solutions-final-section {
    padding-top: var(--section-py-sm);
    padding-bottom: var(--section-py-md);
  }

  .solutions-final-cta {
    max-width: 660px;
  }

  .solutions-final-cta .cta-label {
    color: var(--text-faint);
  }

  .solutions-final-cta h2 {
    color: #f5f5f7;
    font-size: var(--display-title);
    line-height: 1.04;
    letter-spacing: 0;
    margin-bottom: 0;
  }

  .solutions-final-cta h2 span {
    color: var(--text-soft);
  }

  .solutions-final-cta .hero-cta-group {
    margin-top: 34px;
  }

  .solutions-final-cta .btn-ghost {
    background-image:
      linear-gradient(#050505, #050505),
      linear-gradient(rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0.15));
  }

  .solutions-final-cta .btn-ghost:hover {
    animation: none;
    transform: translateY(-2px);
    background-image:
      linear-gradient(#0a0a0c, #0a0a0c),
      linear-gradient(rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0.3));
    box-shadow: 0 10px 26px rgba(255, 255, 255, 0.08);
  }

  .solutions-final-cta .btn-primary:hover {
    box-shadow:
      inset 0 2px 4px rgba(255, 255, 255, 1),
      0 10px 26px rgba(255, 255, 255, 0.14);
  }

  @media (max-width: 860px) {
