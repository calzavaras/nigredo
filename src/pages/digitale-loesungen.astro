---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ServiceVisual from '../components/ServiceVisual.astro';

const pageUrl = 'https://www.nigredo.ch/digitale-loesungen/';
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.nigredo.ch/" },
        { "@type": "ListItem", "position": 2, "name": "Lösungen", "item": pageUrl }
      ]
    },
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      "url": pageUrl,
      "name": "Websites, Software und KI | Nigredo St. Gallen",
      "description": "Individuelle Websites, Software und KI-Lösungen für Selbstständige, KMU und Organisationen. Persönlich konzipiert, zum Fixpreis umgesetzt in St. Gallen.",
      "inLanguage": "de-CH",
      "datePublished": "2025-06-01",
      "dateModified": "2026-10-28T12:00:00+01:00",
      "isPartOf": { "@id": "https://www.nigredo.ch/#website" },
      "publisher": { "@id": "https://www.nigredo.ch/#organization" },
      "breadcrumb": { "@id": `${pageUrl}#breadcrumb` },
      "isAccessibleForFree": true,
      "mainEntity": { "@id": `${pageUrl}#services` }
    },
    {
      "@type": "ItemList",
      "@id": `${pageUrl}#services`,
      "name": "Leistungen",
      "description": "Websites, KI und Software sowie Marke, Inhalt und Struktur aus einer Hand",
      "numberOfItems": 3,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "item": {
            "@type": "Service",
            "@id": `${pageUrl}#website`,
            "name": "Individuelle Websites",
            "url": `${pageUrl}#websites`,
            "description": "Eine gute Website erklärt dein Angebot, schafft Vertrauen und führt Menschen zum nächsten Schritt. Inhalt, Gestaltung und Technik arbeiten dafür gemeinsam.",
            "serviceType": "Webentwicklung",
            "provider": { "@id": "https://www.nigredo.ch/#organization" },
            "brand": { "@id": "https://www.nigredo.ch/#brand" },
            "areaServed": [
              { "@type": "Country", "name": "Schweiz" },
              { "@type": "AdministrativeArea", "name": "Kanton St. Gallen" },
              { "@type": "AdministrativeArea", "name": "Kanton Thurgau" },
              { "@type": "AdministrativeArea", "name": "Kanton Appenzell Ausserrhoden" },
              { "@type": "AdministrativeArea", "name": "Kanton Appenzell Innerrhoden" },
              { "@type": "AdministrativeArea", "name": "Kanton Zürich" }
            ],
            "offers": {
              "@type": "Offer",
              "priceCurrency": "CHF",
              "priceSpecification": { "@type": "UnitPriceSpecification", "description": "Fixpreis" }
            }
          }
        },
        {
          "@type": "ListItem",
          "position": 2,
          "item": {
            "@type": "Service",
            "@id": `${pageUrl}#ki`,
            "name": "KI und Software",
            "url": `${pageUrl}#ki-und-software`,
            "description": "KI-Assistenten, Wissenssysteme, Automatisierungen, lokale Anwendungen und Dashboards, die konkrete Arbeitsschritte verbessern.",
            "serviceType": "Softwareentwicklung und künstliche Intelligenz",
            "provider": { "@id": "https://www.nigredo.ch/#organization" },
            "brand": { "@id": "https://www.nigredo.ch/#brand" },
            "areaServed": [
              { "@type": "Country", "name": "Schweiz" },
              { "@type": "AdministrativeArea", "name": "Kanton St. Gallen" },
              { "@type": "AdministrativeArea", "name": "Kanton Thurgau" },
              { "@type": "AdministrativeArea", "name": "Kanton Appenzell Ausserrhoden" },
              { "@type": "AdministrativeArea", "name": "Kanton Appenzell Innerrhoden" },
              { "@type": "AdministrativeArea", "name": "Kanton Zürich" }
            ]
          }
        },
        {
          "@type": "ListItem",
          "position": 3,
          "item": {
            "@type": "Service",
            "@id": `${pageUrl}#content`,
            "name": "Marke, Inhalt und Struktur",
            "url": `${pageUrl}#marke-und-inhalt`,
            "description": "Namen, Logos, Texte, Bildwelten und Inhaltsstrukturen, die einem Vorhaben ein klares Gesicht geben.",
            "serviceType": "Markenentwicklung, Text und Inhaltsstruktur",
            "provider": { "@id": "https://www.nigredo.ch/#organization" },
            "brand": { "@id": "https://www.nigredo.ch/#brand" },
            "areaServed": [
              { "@type": "Country", "name": "Schweiz" },
              { "@type": "AdministrativeArea", "name": "Kanton St. Gallen" },
              { "@type": "AdministrativeArea", "name": "Kanton Thurgau" },
              { "@type": "AdministrativeArea", "name": "Kanton Appenzell Ausserrhoden" },
              { "@type": "AdministrativeArea", "name": "Kanton Appenzell Innerrhoden" },
              { "@type": "AdministrativeArea", "name": "Kanton Zürich" }
            ]
          }
        }
      ]
    }
  ]
});
---

<Layout
  title="Websites, Software und KI | Nigredo St. Gallen"
  description="Individuelle Websites, Software und KI-Lösungen für Selbstständige, KMU und Organisationen. Persönlich konzipiert, zum Fixpreis umgesetzt in St. Gallen."
  canonical={pageUrl}
  ogTitle="Was digital noch fehlt, entwickle ich."
  ogDescription="Individuelle Websites, Software und Lösungen mit KI für Aufgaben, die Standardprodukte nicht überzeugend abdecken."
  ogImageAlt="Nigredo: individuelle Websites, KI-Lösungen und digitale Werkzeuge"
  twitterTitle="Websites, Software und KI | Nigredo"
  twitterDescription="Digitale Produkte für konkrete Aufgaben, persönlich entwickelt in St. Gallen."
  schema={schema}
>
  <section class="page-hero solutions-hero" aria-labelledby="loesungen-title">
    <div class="container">
      <Breadcrumb items={[
        { label: 'Start', href: '/' },
        { label: 'Lösungen' }
      ]} />
      <h1 id="loesungen-title" class="page-hero__title fade-up">
        Was digital noch fehlt,<br>
        <span class="gradient-text">entwickle ich.</span>
      </h1>
      <div class="page-hero__row fade-up delay-100">
        <p class="page-hero__lead">
          Ich entwickle Websites, Software und digitale Werkzeuge für Aufgaben, die Standardprodukte nicht überzeugend lösen. Aussage, Bedienung, Gestaltung und Technik folgen dabei einer gemeinsamen Richtung. KI eröffnet Varianten und verkürzt Wege. Die Entscheidungen treffe ich.
        </p>
        <div class="page-hero__actions">
          <a href="/kontakt/" class="btn btn-primary">Projekt besprechen</a>
          <a href="/referenzen/" class="section-link">Referenzen ansehen <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="home-section solutions-fields-section" aria-label="Leistungsfelder">
    <div class="container">
      <div class="service-grid solutions-grid" role="list">
        <article id="websites" class="service-card solutions-card fade-up" role="listitem">
          <div class="service-card__visual" aria-hidden="true">
            <ServiceVisual type="web" />
          </div>
          <span class="service-card__label">Websites</span>
          <h2 class="service-card__title">Websites, die nicht nur herumstehen.</h2>
          <p class="service-card__text">Eine gute Website erklärt dein Angebot, schafft Vertrauen und führt Menschen zum nächsten Schritt. Inhalt, Gestaltung und Technik arbeiten dafür gemeinsam.</p>
          <details class="solutions-card__more">
            <summary>Leistungsumfang <span aria-hidden="true"></span></summary>
            <p>Ich entwickle individuelle Websites für Selbstständige, KMU, Organisationen und anspruchsvolle Fachbereiche. Das reicht von einer fokussierten Unternehmensseite bis zu einer Plattform mit Backend oder eigener Inhaltsverwaltung.</p>
            <p>Positionierung, Inhalte und Design verbinde ich mit einer schnellen, zugänglichen und sicheren technischen Umsetzung. Die passende Technik richtet sich nach der Aufgabe.</p>
          </details>
        </article>
        <article id="ki-und-software" class="service-card solutions-card fade-up delay-100" role="listitem">
          <div class="service-card__visual" aria-hidden="true">
            <ServiceVisual type="ki" />
          </div>
          <span class="service-card__label">KI und Software</span>
          <h2 class="service-card__title">KI und Software für echte Aufgaben.</h2>
          <p class="service-card__text">KI ist ein Werkzeug für konkrete Aufgaben. Entscheidend ist, ob ihr Einsatz die Arbeit tatsächlich verbessert.</p>
          <details class="solutions-card__more">
            <summary>Leistungsumfang <span aria-hidden="true"></span></summary>
            <p>Ich entwickle KI-Assistenten, Wissenssysteme, Automatisierungen, lokale Anwendungen und Dashboards, die konkrete Arbeitsschritte verbessern.</p>
            <p>Die Systeme erschliessen Wissen aus Dokumenten und internen Quellen, werten Daten aus und vereinfachen komplexe Abläufe. Spezialisierte KI-Agenten unterstützen mich bei Konzeption, Gestaltung, Entwicklung und Tests. Ich bestimme die Richtung und führe alles zu einem funktionierenden Produkt zusammen.</p>
          </details>
        </article>
        <article id="marke-und-inhalt" class="service-card solutions-card fade-up delay-200" role="listitem">
          <div class="service-card__visual" aria-hidden="true">
            <ServiceVisual type="brand" />
          </div>
          <span class="service-card__label">Marke, Inhalt und Struktur</span>
          <h2 class="service-card__title">Eine Form, die man versteht und behält.</h2>
          <p class="service-card__text">Ein gutes digitales Produkt beginnt mit Klarheit: Was sollen Menschen sehen, verstehen und in Erinnerung behalten?</p>
          <details class="solutions-card__more">
            <summary>Leistungsumfang <span aria-hidden="true"></span></summary>
            <p>Ich entwickle Namen, Logos, Texte, Bildwelten und Inhaltsstrukturen, die einem Vorhaben ein klares Gesicht geben.</p>
            <p>Je nach Aufgabe entstehen daraus eine klare Positionierung, Kernbotschaft, Navigation und Benutzerführung, auch für mehrsprachige oder komplexe Inhalte. Das Ziel ist eine Form, die verstanden wird und im Kopf bleibt.</p>
          </details>
        </article>
      </div>
    </div>
  </section>

  <section class="home-section solutions-process" aria-labelledby="solutions-process-title">
    <div class="container about-split solutions-process__grid">
      <div class="fade-up">
        <p class="page-hero__kicker">Zusammenarbeit</p>
        <h2 id="solutions-process-title" class="home-head__title">Vom Gedanken zum Produkt.<br><span>Ohne unnötige Ehrenrunde.</span></h2>
      </div>
      <ol class="about-steps solutions-steps fade-up delay-100">
          <li><span class="about-steps__label">Zuhören</span><div><strong>Erst zuhören. Dann weiterdenken.</strong><p>Wir klären, was entstehen oder besser funktionieren soll, wer das Produkt nutzt und woran ein gutes Ergebnis erkennbar ist. Eine klare Schwierigkeit oder eine gute Idee reichen als Anfang.</p></div></li>
          <li><span class="about-steps__label">Entscheiden</span><div><strong>Möglichkeiten prüfen. Klar entscheiden.</strong><p>Ich strukturiere die Aufgabe, entwickle sinnvolle Varianten und zeige dir, welcher Weg überzeugt. Du erhältst einen verständlichen Vorschlag mit Umfang, Prioritäten, Fixpreis und realistischem Zeitrahmen.</p></div></li>
          <li><span class="about-steps__label">Umsetzen</span><div><strong>Früh sichtbar. Sauber fertig.</strong><p>Ich texte, gestalte, entwickle und teste. Wo es sinnvoll ist, entstehen früh funktionierende Versionen, damit wir nicht wochenlang über etwas sprechen, das man längst ausprobieren könnte.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="section solutions-final-section" aria-labelledby="loesungen-cta-title">
    <div class="container">
      <div class="section-cta solutions-final-cta fade-up">
        <span class="cta-label">Nächster Schritt</span>
        <h2 id="loesungen-cta-title">Was kostet dich heute<br><span>unnötig Zeit oder Nerven?</span></h2>
        <p>Du musst die Antwort noch nicht kennen. Beschreibe, wo es hakt oder unnötig kompliziert wird. Gemeinsam finden wir heraus, was wirklich hilft.</p>
        <div class="hero-cta-group" style="justify-content: center;">
          <a href="/kontakt/" class="btn btn-primary">Projekt besprechen</a>
          <a href="/referenzen/" class="btn btn-ghost">Referenzen ansehen</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  :global(body) {
    --page-accent-a: var(--solutions-neon-a);
    --page-accent-b: var(--solutions-neon-b);
    --page-accent-c: var(--solutions-neon-c);
    --page-accent: var(--solutions-neon-c);
    --page-title-gradient: linear-gradient(
      102deg in oklab,
      var(--page-accent-a) 0%,
      var(--page-accent-c) 50%,
      var(--page-accent-b) 100%
    );
  }

  .solutions-fields-section {
    padding-top: clamp(72px, 9vw, 120px);
  }

  .solutions-card {
    scroll-margin-top: 120px;
  }

  .solutions-card__more {
    margin: 10px 10px 0;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .solutions-card__more summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #f5f5f7;
    font-size: 0.92rem;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  .solutions-card__more summary::-webkit-details-marker {
    display: none;
  }

  .solutions-card__more summary span {
    position: relative;
    width: 12px;
    height: 12px;
  }

  .solutions-card__more summary span::before,
  .solutions-card__more summary span::after {
    content: "";
    position: absolute;
    left: 0;
    top: 5px;
    width: 12px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.3s ease;
  }

  .solutions-card__more summary span::after {
    transform: rotate(90deg);
  }

  .solutions-card__more[open] summary span::after {
    transform: rotate(0deg);
  }

  .solutions-card__more summary:focus-visible {
    outline: 2px solid var(--page-accent-a);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .solutions-card__more p {
    margin: 14px 0 0;
    color: var(--text-body);
    font-size: 0.95rem;
    line-height: 1.62;
  }

  .solutions-process__grid {
    align-items: start;
  }

  .solutions-process .page-hero__kicker {
    margin: 0 0 18px;
  }

  .solutions-steps {
    margin-top: 0;
  }

  .solutions-steps li {
    grid-template-columns: 130px minmax(0, 1fr);
  }

  .solutions-final-section {
    margin-top: clamp(96px, 12vw, 168px);
  }

  @media (max-width: 620px) {
    .solutions-steps li {
      grid-template-columns: 1fr;
    }
  }
</style>
