---
import Layout from '../layouts/Layout.astro';
import HomeStage from '../components/HomeStage.astro';
import HomeIdea from '../components/HomeIdea.astro';
import ServiceVisual from '../components/ServiceVisual.astro';
import ReferenzVisual from '../components/ReferenzVisual.astro';
import { references } from '../data/references';

const featuredReferenceHrefs = new Set([
  '/referenzen/simona-mueller/',
  '/referenzen/happypath/',
  '/referenzen/portpane/',
]);
const showcase = references.filter(reference => featuredReferenceHrefs.has(reference.href));

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.nigredo.ch/#webpage",
      "url": "https://www.nigredo.ch/",
      "name": "Nigredo St. Gallen | Websites, KI und digitale Produkte",
      "alternateName": ["Nigredo", "Nigredo.ch", "nigredo.ch", "Nigredo St. Gallen", "Nigredo Schweiz"],
      "isPartOf": { "@id": "https://www.nigredo.ch/#website" },
      "about": { "@id": "https://www.nigredo.ch/#organization" },
      "mainEntity": { "@id": "https://www.nigredo.ch/#organization" },
      "publisher": { "@id": "https://www.nigredo.ch/#organization" },
      "significantLink": [
        "https://www.nigredo.ch/digitale-loesungen/",
        "https://www.nigredo.ch/referenzen/",
        "https://www.nigredo.ch/referenzen/portpane/",
        "https://www.nigredo.ch/marco-calzavara/",
        "https://www.nigredo.ch/kontakt/",
        "https://www.nigredo.ch/haeufige-fragen/"
      ],
      "description": "Nigredo entwickelt individuelle Websites, Software und digitale Produkte mit KI. Persönlich geführt von Marco Calzavara in St. Gallen.",
      "datePublished": "2025-06-01",
      "dateModified": "2026-10-28T12:00:00+01:00",
      "inLanguage": "de-CH"
    }
  ]
});

const services = [
  {
    visual: 'web' as const,
    label: 'Websites',
    title: 'Websites mit einer klaren Aufgabe.',
    text: 'Zum Beispiel eine Praxiswebsite, auf der Besucher das passende Angebot finden und direkt einen Termin buchen können.',
    href: '/digitale-loesungen/#websites',
  },
  {
    visual: 'ki' as const,
    label: 'KI und Software',
    title: 'Werkzeuge für konkrete Arbeit.',
    text: 'Etwa ein lokales Dashboard für sensible Daten oder ein KI-Wissenssystem, das Antworten mit Quellen liefert.',
    href: '/digitale-loesungen/#ki-und-software',
  },
  {
    visual: 'brand' as const,
    label: 'Marke, Inhalt und Struktur',
    title: 'Ein Auftritt mit eigener Stimme.',
    text: 'Namen, Texte, Gestaltung und Inhaltsstruktur machen verständlich, wofür ein Angebot steht und an wen es sich richtet.',
    href: '/digitale-loesungen/#marke-und-inhalt',
  },
];
---

<Layout
  title="Nigredo St. Gallen | Websites, KI und digitale Produkte"
  description="Nigredo entwickelt individuelle Websites, Software und digitale Produkte mit KI. Persönlich geführt von Marco Calzavara in St. Gallen."
  canonical="https://www.nigredo.ch/"
  ogTitle="Ich arbeite weiter, wo andere aufhören."
  ogDescription="Aus Ideen werden Websites, Software, Marken und digitale Produkte mit KI. Persönlich geführt und präzise umgesetzt in St. Gallen."
  ogImage="https://www.nigredo.ch/assets/home-digital-craft-1440.jpg"
  ogImageWidth="1440"
  ogImageHeight="960"
  ogImageAlt="Skizzenhafte digitale Oberfläche mit violett-blauer Gestaltung und typografischem Entwurf"
  twitterTitle="Nigredo | Websites, KI und digitale Produkte"
  twitterDescription="Individuelle Websites, Software und digitale Produkte mit KI, persönlich entwickelt in St. Gallen."
  schema={schema}
>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="container home-shell home-hero__inner">
      <p class="home-hero__intro fade-up">Digitale Produkte aus St. Gallen</p>
      <h1 id="hero-title" class="home-hero__title fade-up delay-100">
        Ich arbeite weiter,<br>
        <span class="home-gradient-text">wo andere aufhören.</span>
      </h1>
      <div class="home-hero__row">
        <p class="home-hero__lead fade-up delay-200">
          Ich entwickle individuelle Websites, KI-Lösungen und digitale Werkzeuge für Selbstständige, KMU und Organisationen. Von der ersten Idee bis zur Umsetzung arbeite ich direkt mit dir, bei Bedarf mit meinem Fachnetzwerk.
        </p>
        <div class="home-actions fade-up delay-300">
          <a href="/kontakt/" class="btn btn-primary">Vorhaben besprechen</a>
          <a href="/referenzen/" class="section-link">Arbeiten ansehen <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
    <div class="home-shell home-hero__stage">
      <HomeStage />
    </div>
  </section>

  <section class="home-section home-work" aria-labelledby="work-title">
    <div class="container home-shell">
      <div class="home-head fade-up">
        <h2 id="work-title" class="home-head__title">Drei Projekte.<br><span>Keine Trockenübung.</span></h2>
        <div class="home-head__side">
          <p class="home-head__lead">Von der nativen macOS-App bis zur Praxiswebsite mit Online-Terminbuchung: Diese drei Arbeiten zeigen, wie unterschiedlich konkrete Aufgaben gelöst werden können.</p>
          <a href="/referenzen/" class="section-link">Alle Referenzen <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="work-grid">
        {showcase.map((reference, index) => (
          <article
            class={`work-card${index === 0 ? ' work-card--lead' : ''} fade-up${index > 0 ? ` delay-${index * 100}` : ''}`}
            style={`--card-accent: ${reference.accent};`}
          >
            <div class="work-card__visual">
              <ReferenzVisual
                reference={reference}
                sizes={index === 0 ? '(max-width: 860px) calc(100vw - 48px), 640px' : '(max-width: 860px) calc(100vw - 48px), 540px'}
              />
            </div>
            <div class="work-card__body">
              <p class="work-card__meta"><span>{reference.badge.text}</span><span>{reference.year}</span></p>
              <h3 class="work-card__title">
                <a href={reference.href} class="work-card__link" aria-label={reference.ariaLabel}>{reference.listTitle}</a>
              </h3>
              <p class="work-card__sub">{reference.sub}</p>
              <p class="work-card__role"><span>Rolle</span> {reference.rolle}</p>
              <div class="work-card__footer">
                <span class="work-card__more" aria-hidden="true">Projekt ansehen <span>→</span></span>
                {reference.liveUrl ? (
                  <a href={reference.liveUrl} class="work-card__live" target="_blank" rel="noopener" aria-label={`${reference.listTitle} Website in neuem Tab öffnen`}>Website ansehen <span aria-hidden="true">↗</span></a>
                ) : (
                  <span class="work-card__note">{reference.liveNote}</span>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section home-services" aria-labelledby="services-title">
    <div class="container home-shell">
      <div class="home-head fade-up">
        <h2 id="services-title" class="home-head__title">Was ich möglich mache.</h2>
        <div class="home-head__side">
          <p class="home-head__lead">Drei Bereiche, ein Ansprechpartner: Ich verbinde die passende Lösung mit verständlichen Inhalten und einer klaren Gestaltung.</p>
        </div>
      </div>

      <div class="service-grid">
        {services.map((service, index) => (
          <a href={service.href} class={`service-card service-card--${service.visual} fade-up${index > 0 ? ` delay-${index * 100}` : ''}`}>
            <div class="service-card__visual" aria-hidden="true">
              <ServiceVisual type={service.visual} />
            </div>
            <span class="service-card__label">{service.label}</span>
            <h3 class="service-card__title">{service.title}</h3>
            <p class="service-card__text">{service.text}</p>
            <span class="service-card__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section home-about" aria-labelledby="about-title">
    <div class="container home-shell about-split">
      <figure class="about-split__portrait fade-up">
        <picture>
          <source srcset="/assets/marco-calzavara-home-v5-photo-500.avif 500w, /assets/marco-calzavara-home-v5-photo-750.avif 750w" sizes="(max-width: 860px) 80vw, 420px" type="image/avif">
          <source srcset="/assets/marco-calzavara-home-v5-photo-500.webp 500w, /assets/marco-calzavara-home-v5-photo-750.webp 750w" sizes="(max-width: 860px) 80vw, 420px" type="image/webp">
          <img
            src="/assets/marco-calzavara-home-v5-photo.jpg"
            alt="Marco Calzavara, Gründer von Nigredo in St. Gallen"
            width="1000"
            height="1000"
            loading="lazy"
            decoding="async"
          >
        </picture>
        <figcaption>Marco Calzavara · Nigredo, St. Gallen</figcaption>
      </figure>
      <div class="about-split__content fade-up delay-100">
        <h2 id="about-title" class="home-head__title">Direkt mit mir.<br><span>Von der Idee bis zur Umsetzung.</span></h2>
        <ol class="about-steps">
          <li><span class="about-steps__label">Zuhören</span><p>Du erklärst mir, was du erreichen möchtest.</p></li>
          <li><span class="about-steps__label">Klären</span><p>Ich kläre, was es dafür braucht.</p></li>
          <li><span class="about-steps__label">Umsetzen</span><p>Ich setze die passende Lösung um und halte dich verständlich auf dem Laufenden.</p></li>
        </ol>
        <p class="about-split__note">Wenn zusätzliche Fachleute nötig sind, koordiniere ich sie. Für dich bleibt die Zusammenarbeit einfach.</p>
        <a href="/marco-calzavara/" class="section-link">Mehr über mich <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <HomeIdea />
</Layout>

<style>
  :global(body) {
    --page-accent-a: oklch(72% 0.29 342);
    --page-accent-b: oklch(67% 0.22 252);
    --page-accent-c: oklch(68% 0.3 326);
    --page-accent: var(--page-accent-c);
    --page-title-gradient: linear-gradient(
      102deg in oklab,
      var(--page-accent-a) 0%,
      var(--page-accent-c) 38%,
      var(--page-accent-b) 100%
    );
    --text-body: rgba(245, 245, 247, 0.76);
    --text-soft: rgba(255, 255, 255, 0.64);
    --text-faint: rgba(255, 255, 255, 0.5);
  }

  .home-hero {
    --home-divider: rgba(255, 255, 255, 0.08);
  }

  .home-gradient-text {
    display: inline-block;
    color: #f5f5f7;
    background: var(--page-title-gradient);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: none;
  }

  .home-hero {
    overflow: clip;
    padding: 136px 0 clamp(80px, 9vw, 128px);
    position: relative;
    box-sizing: border-box;
  }

  .home-hero::after {
    content: "";
    position: absolute;
    left: max(var(--container-gutter), calc((100vw - var(--shell-width)) / 2));
    right: max(var(--container-gutter), calc((100vw - var(--shell-width)) / 2));
    bottom: 0;
    height: 1px;
    background: var(--home-divider);
  }

  .home-hero__inner {
    position: relative;
  }

  .home-hero__intro {
    margin: 0 0 clamp(24px, 3.2vw, 36px);
    position: relative;
    z-index: 2;
    color: #e2dce9;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .home-hero__title {
    position: relative;
    z-index: 2;
    max-width: 940px;
    margin: 0;
    font-size: clamp(3.35rem, 6.85vw, 5.75rem);
    line-height: 1;
    letter-spacing: -0.036em;
  }

  .home-hero__row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px 48px;
    margin-top: clamp(32px, 4.3vw, 48px);
  }

  .home-hero__stage {
    position: relative;
    z-index: 1;
    width: min(1120px, calc(100% - (2 * var(--container-gutter))));
    margin: clamp(44px, 5vw, 72px) auto 0;
  }

  .home-hero__lead {
    position: relative;
    z-index: 2;
    max-width: 480px;
    margin: 0;
    color: var(--text-body);
    font-size: 1.08rem;
    line-height: 1.62;
    text-wrap: pretty;
  }

  .home-actions {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: clamp(22px, 4vw, 38px);
  }

  @media (max-width: 860px) {
    .home-hero__lead {
      max-width: 620px;
    }

    .home-hero__row {
      flex-direction: column;
      align-items: flex-start;
    }

    .home-hero {
      padding-top: 156px;
      padding-bottom: 64px;
    }

    .home-hero::after {
      left: var(--container-gutter);
      right: var(--container-gutter);
    }

    .home-hero__title {
      font-size: clamp(3rem, 9.6vw, 4.7rem);
    }
  }

  @media (max-width: 620px) {
    .home-hero {
      padding-top: 118px;
      padding-bottom: 54px;
    }

    .home-hero__intro {
      margin-bottom: 20px;
      font-size: 0.94rem;
    }

    .home-hero__title {
      font-size: clamp(2.35rem, 10.2vw, 3rem);
      line-height: 1.035;
      letter-spacing: -0.025em;
    }

    .home-hero__row {
      gap: 28px;
      margin-top: 18px;
    }

    .home-hero__lead {
      font-size: 1rem;
      line-height: 1.66;
    }

    .home-actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 16px;
    }

    .home-hero__stage {
      margin-top: 44px;
    }
  }
</style>
