---
import Layout from '../layouts/Layout.astro';
import ReferenzVisual from '../components/ReferenzVisual.astro';
import { references } from '../data/references';

const showcase = references.slice(0, 3);

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebPage", "HomePage"],
      "@id": "https://www.nigredo.ch/#webpage",
      "url": "https://www.nigredo.ch/",
      "name": "Nigredo St. Gallen | Websites, KI und digitale Produkte",
      "alternateName": ["Nigredo", "Nigredo.ch", "nigredo.ch", "Nigredo St. Gallen", "Nigredo Schweiz"],
      "isPartOf": { "@id": "https://www.nigredo.ch/#website" },
      "about": { "@id": "https://www.nigredo.ch/#organization" },
      "mainEntity": { "@id": "https://www.nigredo.ch/#organization" },
      "publisher": { "@id": "https://www.nigredo.ch/#organization" },
      "primaryImageOfPage": { "@id": "https://www.nigredo.ch/#logo" },
      "significantLink": [
        "https://www.nigredo.ch/digitale-loesungen/",
        "https://www.nigredo.ch/referenzen/",
        "https://www.nigredo.ch/marco-calzavara/",
        "https://www.nigredo.ch/kontakt/",
        "https://www.nigredo.ch/haeufige-fragen/"
      ],
      "description": "Nigredo entwickelt individuelle Websites, Software und digitale Produkte mit KI. Persönlich geführt von Marco Calzavara in St. Gallen.",
      "datePublished": "2025-06-01",
      "dateModified": "2026-08-01T12:00:00+02:00",
      "inLanguage": "de-CH"
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.nigredo.ch/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Start", "item": "https://www.nigredo.ch/" }
      ]
    }
  ]
});

const services = [
  {
    number: '01',
    label: 'Websites',
    title: 'Digitale Auftritte, die etwas auslösen.',
    text: 'Von der fokussierten Unternehmensseite bis zur Website mit Backend, Datenbank, Login oder eigener Verwaltung. Struktur, Text, Gestaltung und Technik führen Menschen verständlich zum richtigen nächsten Schritt.',
  },
  {
    number: '02',
    label: 'KI-Lösungen',
    title: 'Intelligenz mit einer klaren Aufgabe.',
    text: 'Assistenten, Wissenssysteme und Automatisierungen machen Informationen nutzbar und Arbeit einfacher. Nicht jede Aufgabe braucht KI. Wenn sie spürbar hilft, setze ich sie konsequent ein.',
  },
  {
    number: '03',
    label: 'Werkzeuge und Anwendungen',
    title: 'Software, die sich der Arbeit anpasst.',
    text: 'Lokale Anwendungen, Plattformen, Dashboards und individuelle Werkzeuge für Aufgaben, bei denen Standardsoftware zu viel, zu wenig oder schlicht das Falsche kann. Auf Wunsch darf die Cloud draussen warten.',
  },
  {
    number: '04',
    label: 'Marke, Inhalt und Struktur',
    title: 'Eine Form, die man versteht und behält.',
    text: 'Namen, Logos, Texte, Bildwelten und durchdachte Inhaltsstrukturen geben einem Vorhaben Identität. Entscheidend ist nicht nur eine schöne Oberfläche, sondern eine Geschichte, die im Kopf bleibt.',
  },
];
---

<Layout
  title="Nigredo St. Gallen | Websites, KI und digitale Produkte"
  description="Nigredo entwickelt individuelle Websites, Software und digitale Produkte mit KI. Persönlich geführt von Marco Calzavara in St. Gallen."
  canonical="https://www.nigredo.ch/"
  ogTitle="Ich arbeite weiter, wo andere aufhören."
  ogDescription="Aus Ideen werden Websites, Software, Marken und digitale Produkte mit KI. Persönlich geführt und präzise umgesetzt in St. Gallen."
  ogImageAlt="Nigredo: Websites, KI-Lösungen und digitale Werkzeuge aus St. Gallen"
  twitterTitle="Nigredo | Websites, KI und digitale Produkte"
  twitterDescription="Individuelle Websites, Software und digitale Produkte mit KI, persönlich entwickelt in St. Gallen."
  schema={schema}
>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="container home-hero__inner">
      <p class="home-hero__intro fade-up">Digitale Produkte aus St. Gallen</p>
      <h1 id="hero-title" class="home-hero__title fade-up delay-100">
        Ich arbeite weiter,<br>
        <span class="home-gradient-text">wo andere aufhören.</span>
      </h1>
      <p class="home-hero__lead fade-up delay-200">
        Aus Ideen werden Websites, Anwendungen, Marken und Inhalte. Ich verbinde Gestaltung, Technik, KI und ein starkes Fachnetzwerk zu digitalen Produkten, die rasch Form annehmen und nicht nach Vorlage aussehen. Persönlich geführt, passend zur Aufgabe und sauber umgesetzt.
      </p>
      <div class="home-actions fade-up delay-300">
        <a href="/kontakt/" class="btn btn-primary">Vorhaben besprechen</a>
        <a href="/referenzen/" class="section-link">Arbeiten ansehen <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section section--lg home-services" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head fade-up">
        <h2 id="services-title" class="section-head__title">Was ich möglich mache.</h2>
        <p class="section-head__lead">Manchmal braucht es eine Website. Manchmal ein Werkzeug, das es noch nicht gibt. Und manchmal beginnt alles mit dem Satz: «Eigentlich müsste man doch …» Genau dort werde ich aufmerksam.</p>
      </div>

      <div class="numbered-rows">
        {services.map((service, index) => (
          <a
            href="/digitale-loesungen/"
            class={`numbered-row fade-up${index > 0 ? ` delay-${index * 100}` : ''}`}
          >
            <span class="numbered-row__num" aria-hidden="true">{service.number}</span>
            <div>
              <span class="numbered-row__label">{service.label}</span>
              <h3 class="numbered-row__title">{service.title}</h3>
            </div>
            <p class="numbered-row__text">{service.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--lg home-work" aria-labelledby="work-title">
    <div class="container">
      <div class="section-head section-head--split fade-up">
        <div>
          <h2 id="work-title" class="section-head__title">Drei Projekte.<br>Keine Trockenübung.</h2>
          <p class="section-head__lead">Hier entstehen Websites, Anwendungen und digitale Werkzeuge, die konkrete Aufgaben lösen und im Alltag zuverlässig funktionieren. Meine drei jüngsten Projekte zeigen, wie das aussieht.</p>
        </div>
        <a href="/referenzen/" class="section-link">Alle Referenzen <span aria-hidden="true">→</span></a>
      </div>

      <div class="showcase-grid">
        {showcase.map((reference, index) => (
          <article
            class={`showcase-card fade-up${index > 0 ? ` delay-${index * 100}` : ''}`}
            style={`--card-accent: ${reference.accent};`}
          >
            <div class="showcase-card__visual">
              <ReferenzVisual
                reference={reference}
                sizes="(max-width: 620px) calc(100vw - 40px), (max-width: 860px) 42vw, 300px"
                priority={index === 0}
              />
            </div>
            <div class="showcase-card__body">
              <div class="showcase-card__meta">
                <span class="showcase-card__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <span class="showcase-card__type">{reference.badge.text}</span>
                <span class="showcase-card__year">{reference.year}</span>
              </div>
              <h3 class="showcase-card__title">{reference.listTitle}</h3>
              <p class="showcase-card__sub">{reference.sub}</p>
              <p class="showcase-card__role"><span>Rolle:</span> {reference.rolle}</p>
              <div class="showcase-card__footer">
                <a href={reference.href} class="showcase-card__details" aria-label={reference.ariaLabel}>Projekt ansehen <span aria-hidden="true">→</span></a>
                {reference.liveUrl ? (
                  <a href={reference.liveUrl} class="showcase-card__live" target="_blank" rel="noopener" aria-label={`${reference.listTitle} Website in neuem Tab öffnen`}>Website ansehen <span aria-hidden="true">↗</span></a>
                ) : (
                  <span class="showcase-card__note">{reference.liveNote}</span>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--lg home-about" aria-labelledby="about-title">
    <div class="container about-strip fade-up">
      <div class="about-strip__identity">
        <div class="about-strip__portrait">
          <picture>
            <source srcset="/assets/marco-calzavara-home-v5-round-500.avif 500w" sizes="(max-width: 620px) 112px, (max-width: 860px) 128px, 140px" type="image/avif">
            <source srcset="/assets/marco-calzavara-home-v5-round-500.webp 500w" sizes="(max-width: 620px) 112px, (max-width: 860px) 128px, 140px" type="image/webp">
            <img
              src="/assets/marco-calzavara-home-v5-round.jpg"
              alt="Marco Calzavara, Gründer von Nigredo in St. Gallen"
              width="760"
              height="760"
              loading="lazy"
              decoding="async"
            >
          </picture>
        </div>
      </div>
      <div class="about-strip__content">
        <h2 id="about-title" class="about-strip__title">Direkt mit mir.<br><span>Von der Idee bis zur Umsetzung.</span></h2>
        <p class="about-strip__lead">Du erklärst mir, was du erreichen möchtest. Ich kläre, was es dafür braucht, setze die passende Lösung um und halte dich verständlich auf dem Laufenden. Wenn zusätzliche Fachleute nötig sind, koordiniere ich sie. Für dich bleibt die Zusammenarbeit einfach.</p>
        <a href="/marco-calzavara/" class="section-link about-strip__link">Mehr über mich <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="final-cta-section" aria-labelledby="cta-title">
    <div class="container final-cta-content final-cta-content--centered fade-up">
      <span class="cta-label">Der nächste Schritt</span>
      <h2 id="cta-title">
        Was wartet schon zu lange<br>
        <span>auf die Umsetzung?</span>
      </h2>
      <p>Ein Satz, eine Skizze, ein umständlicher Ablauf oder eine Vorstellung davon, was besser werden könnte, genügen. Ich höre zu, denke weiter und sage dir offen, welcher Weg sinnvoll ist.</p>
      <div class="hero-cta-group">
        <a href="/kontakt/" class="btn btn-primary">Idee besprechen</a>
        <a href="/referenzen/" class="btn btn-ghost">Referenzen ansehen</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  :global(body) {
    --page-accent-a: oklch(72% 0.29 342);
    --page-accent-b: oklch(67% 0.22 252);
    --page-accent-c: oklch(68% 0.3 326);
    --page-accent: var(--page-accent-c);
    --page-title-gradient: linear-gradient(
      102deg in oklab,
      var(--page-accent-a) 0%,
      var(--page-accent-c) 38%,
      var(--page-accent-b) 100%
    );
    --text-body: rgba(245, 245, 247, 0.76);
    --text-soft: rgba(255, 255, 255, 0.64);
    --text-faint: rgba(255, 255, 255, 0.5);
  }

  .home-hero {
    --home-divider: rgba(255, 255, 255, 0.08);
  }

  .home-gradient-text {
    display: inline-block;
    color: #f5f5f7;
    background: var(--page-title-gradient);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: none;
  }

  .home-hero {
    min-height: min(830px, 90svh);
    display: flex;
    align-items: center;
    padding: clamp(156px, 16vh, 204px) 0 clamp(100px, 13vh, 148px);
    position: relative;
    box-sizing: border-box;
  }

  .home-hero::after {
    content: "";
    position: absolute;
    left: max(var(--container-gutter), calc((100vw - var(--shell-width)) / 2));
    right: max(var(--container-gutter), calc((100vw - var(--shell-width)) / 2));
    bottom: 0;
    height: 1px;
    background: var(--home-divider);
  }

  .home-hero__inner {
    width: 100%;
  }

  .home-hero__intro {
    margin: 0 0 clamp(24px, 3.2vw, 36px);
    color: var(--text-soft);
    font-size: 0.88rem;
    font-weight: 550;
    letter-spacing: 0.02em;
  }

  .home-hero__title {
    max-width: 940px;
    margin: 0;
    font-size: clamp(3.35rem, 6.85vw, 5.75rem);
    line-height: 1;
    letter-spacing: -0.036em;
  }

  .home-hero__lead {
    max-width: 680px;
    margin: clamp(32px, 4.3vw, 48px) 0 0;
    color: var(--text-body);
    font-size: clamp(1.11rem, 1.55vw, 1.27rem);
    line-height: 1.62;
    text-wrap: pretty;
  }

  .home-actions {
    display: flex;
    align-items: center;
    gap: clamp(22px, 4vw, 38px);
    margin-top: clamp(32px, 4.3vw, 46px);
  }

  @media (max-width: 860px) {
    .home-hero {
      min-height: auto;
      padding-top: 156px;
      padding-bottom: 104px;
    }

    .home-hero::after {
      left: var(--container-gutter);
      right: var(--container-gutter);
    }

    .home-hero__title {
      font-size: clamp(3rem, 9.6vw, 4.7rem);
    }
  }

  @media (max-width: 620px) {
    .home-hero {
      padding-top: 136px;
      padding-bottom: 82px;
    }

    .home-hero__intro {
      margin-bottom: 22px;
      font-size: 0.875rem;
    }

    .home-hero__title {
      font-size: clamp(2.6rem, 11.6vw, 3.4rem);
      line-height: 1.035;
      letter-spacing: -0.025em;
    }

    .home-hero__lead {
      margin-top: 28px;
      font-size: 1.04rem;
      line-height: 1.66;
    }

    .home-actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 20px;
      margin-top: 32px;
    }
  }
</style>
