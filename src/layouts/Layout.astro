---
import '../styles/global.css';
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { resolve } from 'node:path';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  robots?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: string;
  ogImageHeight?: string;
  ogImageType?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  author?: string;
  profileFirstName?: string;
  profileLastName?: string;
  profileUsername?: string;
  schema?: string;
  preloadImage?: string;
  preloadImageType?: string;
  preloadImageSrcset?: string;
  preloadImageSizes?: string;
  prevUrl?: string;
  nextUrl?: string;
}

const mainScriptPath = resolve(process.cwd(), 'static/main.min.js');

function getMainScriptVersion(): string {
  try {
    const script = readFileSync(mainScriptPath);
    return createHash('sha256').update(script).digest('hex').slice(0, 12);
  } catch {
    return process.env.npm_package_version ?? '1';
  }
}

const jsVersion = getMainScriptVersion();
const faviconVersion = '20260518';

const {
  title,
  description,
  canonical,
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  ogTitle,
  ogDescription,
  ogType = 'website',
  ogImage = 'https://www.nigredo.ch/android-chrome-512x512.png',
  ogImageAlt = 'Nigredo Icon',
  ogImageWidth = '512',
  ogImageHeight = '512',
  ogImageType,
  twitterTitle,
  twitterDescription,
  author = 'Nigredo',
  profileFirstName,
  profileLastName,
  profileUsername,
  schema,
  preloadImage,
  preloadImageType,
  preloadImageSrcset,
  preloadImageSizes,
  prevUrl,
  nextUrl,
} = Astro.props;

function inferImageType(image: string | undefined): string | undefined {
  const path = image?.split('?')[0]?.toLowerCase();
  if (!path) return undefined;
  if (path.endsWith('.jpg') || path.endsWith('.jpeg')) return 'image/jpeg';
  if (path.endsWith('.png')) return 'image/png';
  if (path.endsWith('.webp')) return 'image/webp';
  if (path.endsWith('.avif')) return 'image/avif';
  return undefined;
}

const resolvedOgImageType = ogImageType ?? inferImageType(ogImage);
const canonicalUrl = canonical === 'https://www.nigredo.ch'
  ? 'https://www.nigredo.ch/'
  : (canonical.endsWith('/') ? canonical : `${canonical}/`);
const ogImageRatio = Number(ogImageWidth) / Number(ogImageHeight);
const twitterCard = ogImage && Number(ogImageWidth) >= 600 && Number(ogImageHeight) >= 315 && ogImageRatio >= 1.4
  ? 'summary_large_image'
  : 'summary';

// Schlanker, konsistenter Entitätsgraph. Seitenspezifische Inhalte bleiben in den
// jeweiligen Seitenschemas, damit die strukturierten Daten den sichtbaren Inhalt
// präzise abbilden und nicht durch globale Navigationsdaten verwässert werden.
const siteIdentitySchema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://www.nigredo.ch/#website",
      "name": "Nigredo",
      "alternateName": ["Nigredo.ch", "Nigredo St. Gallen"],
      "url": "https://www.nigredo.ch/",
      "description": "Nigredo entwickelt individuelle Websites, Software und Lösungen mit KI in St. Gallen.",
      "inLanguage": "de-CH",
      "publisher": { "@id": "https://www.nigredo.ch/#organization" },
      "about": { "@id": "https://www.nigredo.ch/#organization" }
    },
    {
      "@type": ["ProfessionalService", "Organization"],
      "@id": "https://www.nigredo.ch/#organization",
      "name": "Nigredo",
      "legalName": "Nigredo",
      "alternateName": ["Nigredo.ch", "Nigredo St. Gallen"],
      "url": "https://www.nigredo.ch/",
      "description": "Persönlich geführtes Schweizer Entwicklungsstudio für Websites, individuelle Software und Lösungen mit KI.",
      "identifier": {
        "@type": "PropertyValue",
        "propertyID": "domain",
        "value": "nigredo.ch"
      },
      "brand": {
        "@type": "Brand",
        "@id": "https://www.nigredo.ch/#brand",
        "name": "Nigredo",
        "alternateName": ["Nigredo.ch", "Nigredo St. Gallen"],
        "logo": { "@id": "https://www.nigredo.ch/#logo" },
        "url": "https://www.nigredo.ch/"
      },
      "logo": {
        "@type": "ImageObject",
        "@id": "https://www.nigredo.ch/#logo",
        "url": "https://www.nigredo.ch/android-chrome-512x512.png",
        "contentUrl": "https://www.nigredo.ch/android-chrome-512x512.png",
        "width": 512,
        "height": 512,
        "caption": "Nigredo Icon"
      },
      "image": { "@id": "https://www.nigredo.ch/#logo" },
      "founder": {
        "@type": "Person",
        "@id": "https://www.nigredo.ch/#person",
        "name": "Marco Calzavara"
      },
      "foundingDate": "2025",
      "foundingLocation": {
        "@type": "Place",
        "name": "St. Gallen, Schweiz",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "St. Gallen",
          "addressRegion": "SG",
          "addressCountry": "CH"
        }
      },
      "knowsAbout": ["Webdesign", "Softwareentwicklung", "Künstliche Intelligenz", "Branding", "User Experience Design", "Automatisierung"],
      "numberOfEmployees": { "@type": "QuantitativeValue", "value": 1 },
      "areaServed": [
        { "@type": "Country", "name": "Schweiz" },
        { "@type": "AdministrativeArea", "name": "St. Gallen" },
        { "@type": "AdministrativeArea", "name": "Ostschweiz" }
      ],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Wildeggstrasse 37",
        "addressLocality": "St. Gallen",
        "postalCode": "9000",
        "addressRegion": "SG",
        "addressCountry": "CH"
      },
      "makesOffer": [
        { "@type": "Offer", "itemOffered": { "@id": "https://www.nigredo.ch/digitale-loesungen/#website" } },
        { "@type": "Offer", "itemOffered": { "@id": "https://www.nigredo.ch/digitale-loesungen/#ki" } },
        { "@type": "Offer", "itemOffered": { "@id": "https://www.nigredo.ch/digitale-loesungen/#content" } }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Digitale Dienstleistungen",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": { "@type": "Service", "name": "Individuelle Websites und Webdesign" }
          },
          {
            "@type": "Offer",
            "itemOffered": { "@type": "Service", "name": "Lösungen mit KI und Automatisierung" }
          },
          {
            "@type": "Offer",
            "itemOffered": { "@type": "Service", "name": "Individuelle Software und digitale Werkzeuge" }
          }
        ]
      },
      "sameAs": [
        "https://ch.linkedin.com/in/calzavara-marco",
        "https://github.com/calza"
      ]
    },
    {
      "@type": "Person",
      "@id": "https://www.nigredo.ch/#person",
      "name": "Marco Calzavara",
      "givenName": "Marco",
      "familyName": "Calzavara",
      "jobTitle": "Unternehmer, Gründer und Full Stack Developer",
      "description": "Marco Calzavara ist Unternehmer, Gründer von Nigredo und Full Stack Developer in St. Gallen. Er verbindet Führung, Gestaltung, Softwareentwicklung und KI.",
      "url": "https://www.nigredo.ch/marco-calzavara/",
      "mainEntityOfPage": { "@id": "https://www.nigredo.ch/marco-calzavara/#webpage" },
      "image": {
        "@type": "ImageObject",
        "@id": "https://www.nigredo.ch/marco-calzavara/#primaryimage",
        "url": "https://www.nigredo.ch/assets/marco-calzavara-home-v5-photo.jpg",
        "contentUrl": "https://www.nigredo.ch/assets/marco-calzavara-home-v5-photo.jpg",
        "thumbnailUrl": "https://www.nigredo.ch/assets/marco-calzavara-home-v5-photo-500.webp",
        "width": 1000,
        "height": 1000,
        "caption": "Marco Calzavara, Gründer von Nigredo in St. Gallen"
      },
      "worksFor": { "@id": "https://www.nigredo.ch/#organization" },
      "affiliation": {
        "@type": "Organization",
        "@id": "https://happypath.ch/#organization",
        "name": "HappyPath GmbH",
        "url": "https://happypath.ch/"
      },
      "knowsAbout": ["Führung", "Unternehmertum", "Webdesign", "Softwareentwicklung", "Künstliche Intelligenz", "Branding", "User Experience Design", "Automatisierung"],
      "sameAs": [
        "https://ch.linkedin.com/in/calzavara-marco",
        "https://github.com/calza"
      ]
    }
  ]
});
---

<!DOCTYPE html>
<html lang="de-CH">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

  <link rel="preconnect" href="https://cloud.umami.is" crossorigin>
  <link rel="dns-prefetch" href="https://cloud.umami.is">
  <link rel="preload" href="/fonts/bricolage-grotesque-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" as="image" href="/assets/nigredo-logo-header.webp" type="image/webp">

  {preloadImage && (
    <link rel="preload" as="image" href={preloadImage} type={preloadImageType || undefined} imagesrcset={preloadImageSrcset || undefined} imagesizes={preloadImageSizes || undefined} />
  )}
  <meta name="format-detection" content="telephone=no">
  <meta name="theme-color" content="#050505">
  <meta name="color-scheme" content="dark">
  <meta name="application-name" content="Nigredo">
  <meta name="apple-mobile-web-app-title" content="Nigredo">
  <link rel="icon" href={`/favicon.ico?v=${faviconVersion}`} sizes="any">
  <link rel="icon" type="image/png" sizes="16x16" href={`/favicon-16x16.png?v=${faviconVersion}`}>
  <link rel="icon" type="image/png" sizes="32x32" href={`/favicon-32x32.png?v=${faviconVersion}`}>
  <link rel="icon" type="image/png" sizes="48x48" href={`/favicon-48x48.png?v=${faviconVersion}`}>
  <link rel="apple-touch-icon" sizes="180x180" href={`/apple-touch-icon.png?v=${faviconVersion}`}>
  <link rel="manifest" href={`/site.webmanifest?v=${faviconVersion}`}>
  <meta name="msapplication-TileColor" content="#050505">
  <meta name="msapplication-TileImage" content={`/mstile-150x150.png?v=${faviconVersion}`}>

  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="author" content={author}>
  <meta name="publisher" content="Nigredo">
  <meta name="robots" content={robots}>
  <link rel="canonical" href={canonicalUrl}>
  {prevUrl && <link rel="prev" href={prevUrl}>}
  {nextUrl && <link rel="next" href={nextUrl}>}
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt: Nigredo für KI-Bots">
  <link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLMs-full.txt: vollständige Inhalte für KI-Systeme">

  <meta property="og:title" content={ogTitle || title}>
  <meta property="og:description" content={ogDescription || description}>
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:locale" content="de_CH">
  <meta property="og:site_name" content="Nigredo">
  {ogType === 'profile' && profileFirstName && <meta property="profile:first_name" content={profileFirstName}>}
  {ogType === 'profile' && profileLastName && <meta property="profile:last_name" content={profileLastName}>}
  {ogType === 'profile' && profileUsername && <meta property="profile:username" content={profileUsername}>}
  {ogImage && <meta property="og:image" content={ogImage}>}
  {ogImage && <meta property="og:image:secure_url" content={ogImage}>}
  {ogImage && <meta property="og:image:alt" content={ogImageAlt}>}
  {ogImage && <meta property="og:image:width" content={ogImageWidth}>}
  {ogImage && <meta property="og:image:height" content={ogImageHeight}>}
  {ogImage && resolvedOgImageType && <meta property="og:image:type" content={resolvedOgImageType}>}

  <meta name="twitter:card" content={twitterCard}>
  <meta name="twitter:title" content={twitterTitle || ogTitle || title}>
  <meta name="twitter:description" content={twitterDescription || ogDescription || description}>
  {ogImage && <meta name="twitter:image" content={ogImage}>}
  {ogImage && <meta name="twitter:image:alt" content={ogImageAlt}>}

  <meta name="umami-src" content="https://cloud.umami.is/script.js">
  <meta name="umami-website-id" content="78dc26c9-7537-4816-a7e1-9acc31bf1402">

  <!-- Hreflang: Sprache deklarieren -->
  <link rel="alternate" hreflang="de-CH" href={canonicalUrl}>
  <link rel="alternate" hreflang="x-default" href={canonicalUrl}>

  <!-- Globales Entitäts- und Navigationsschema -->
  <script type="application/ld+json" set:html={siteIdentitySchema} />
  {schema && <script type="application/ld+json" set:html={schema} />}
</head>
<body>

  <a href="#main-content" class="skip-link">Zum Hauptinhalt springen</a>

  <Header />

  <main id="main-content">
    <slot />
  </main>

  <Footer />

  <script src={`/main.min.js?v=${jsVersion}`} defer></script>

</body>
</html>
